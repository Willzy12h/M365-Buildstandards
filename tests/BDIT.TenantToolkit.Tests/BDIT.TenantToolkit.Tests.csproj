<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>BDIT.TenantToolkit.Tests</AssemblyName>
    <RootNamespace>BDIT.TenantToolkit.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BDIT.TenantToolkit.Core\BDIT.TenantToolkit.Core.csproj" />
    <ProjectReference Include="..\..\src\BDIT.TenantToolkit.Graph\BDIT.TenantToolkit.Graph.csproj" />
    <ProjectReference Include="..\..\src\BDIT.TenantToolkit.Engine\BDIT.TenantToolkit.Engine.csproj" />
    <ProjectReference Include="..\..\src\BDIT.TenantToolkit.Cli\BDIT.TenantToolkit.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exercise the actual isolated doctor handler before sequential CLI dispatch wiring. -->
    <Compile Include="..\..\src\BDIT.TenantToolkit.Cli\DoctorCommand.cs" Link="Cli\DoctorCommand.cs" />
    <!-- Portable execution of the exact desktop coordinator; WPF command/binding cases remain in App.Tests. -->
    <Compile Include="..\..\src\BDIT.TenantToolkit.App\Services\OfflinePrerequisiteDiagnostic.cs" Link="App\OfflinePrerequisiteDiagnostic.cs" />
    <Compile Include="..\..\src\BDIT.TenantToolkit.App\Infrastructure\ObservableObject.cs" Link="App\ObservableObject.cs" />
    <Compile Include="..\BDIT.TenantToolkit.App.Tests\OfflinePrerequisiteDiagnosticTests.cs" Link="App\OfflinePrerequisiteDiagnosticTests.cs" />
    <!-- Synthetic runner fixtures: a stand-in Exchange module and a schema 2 body. Never Microsoft code. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
