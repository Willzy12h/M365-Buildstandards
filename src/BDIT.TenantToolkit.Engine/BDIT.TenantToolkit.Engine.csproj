<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BDIT.TenantToolkit.Engine</AssemblyName>
    <RootNamespace>BDIT.TenantToolkit.Engine</RootNamespace>
    <Description>Standards loading, collection, assessment, deviations, drift, planning, guarded execution, evidence and reports.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Exchange\ReadCapture.ps1" LogicalName="Exchange.ReadCapture.ps1" />
    <!-- The fixed launcher for the Scripts & Reports Run action. Not part of the library, so it is not in the registry. -->
    <EmbeddedResource Include="Scripts\RunLibraryScript.ps1" LogicalName="ScriptRun.Launcher.ps1" />
    <!-- The reviewed script library (INT-072). Every file here must be pinned in scripts/registry.json or the library is refused. -->
    <EmbeddedResource Include="..\..\scripts\**\*.json;..\..\scripts\**\*.ps1" LogicalName="Scripts/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\BDIT.TenantToolkit.Core\BDIT.TenantToolkit.Core.csproj" />
    <ProjectReference Include="..\BDIT.TenantToolkit.Graph\BDIT.TenantToolkit.Graph.csproj" />
  </ItemGroup>
</Project>
