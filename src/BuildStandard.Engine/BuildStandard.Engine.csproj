<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BuildStandard.Engine</AssemblyName>
    <RootNamespace>BuildStandard.Engine</RootNamespace>
    <Description>Standards loading, collection, assessment, deviations, drift, planning, guarded execution, evidence and reports.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Exchange\ReadCapture.ps1" LogicalName="Exchange.ReadCapture.ps1" />
    <!-- INT-088 owned read-only runner wrapper, pinned by ReadRunnerTemplate.Sha256. Outside scripts/, so never a library item. -->
    <EmbeddedResource Include="Scripts\Runner\ReadRunner.ps1" LogicalName="Runner.ReadRunner.ps1" />
    <!-- The reviewed script library (INT-072). Every file here must be pinned in scripts/registry.json or the library is refused. -->
    <EmbeddedResource Include="..\..\scripts\**\*.json;..\..\scripts\**\*.ps1" LogicalName="Scripts/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\BuildStandard.Core\BuildStandard.Core.csproj" />
    <ProjectReference Include="..\BuildStandard.Graph\BuildStandard.Graph.csproj" />
  </ItemGroup>
</Project>
