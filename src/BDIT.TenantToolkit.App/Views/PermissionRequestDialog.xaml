<Window x:Class="BDIT.TenantToolkit.App.Views.PermissionRequestDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review Microsoft access request" Width="680" Height="620" MinWidth="540" MinHeight="460"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Review access before Microsoft sign-in or consent" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="This approves only the displayed access request. Microsoft may require credentials, MFA or administrator consent. Returned identity is verified separately; this does not enable or approve tenant changes." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#F1F5F9" Padding="12" AutomationProperties.Name="Access purpose, tenant, application, resource and exact requested permissions"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <CheckBox x:Name="ApprovalBox" Checked="OnApprovalChanged" Unchecked="OnApprovalChanged" AutomationProperties.Name="Approve this exact Microsoft access request">
    <TextBlock Text="I approve this exact access request. It does not approve a tenant operation." TextWrapping="Wrap"/>
   </CheckBox>
   <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
    <Button Content="Cancel" IsCancel="True" Click="OnCancel" Padding="18,8" Margin="0,0,12,0"/>
    <Button x:Name="ContinueButton" Content="Continue to Microsoft" IsDefault="True" IsEnabled="False" Click="OnContinue" Padding="18,8"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
