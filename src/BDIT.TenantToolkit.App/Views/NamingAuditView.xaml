<UserControl x:Class="BDIT.TenantToolkit.App.Views.NamingAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="REPORTS / SUPPLIED CAPTURE" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Naming and ownership" Style="{StaticResource H1}"/>
        <TextBlock Text="Review recorded names and toolkit ownership evidence. Names alone prove neither ownership nor compliance. This page never collects, renames or edits history." Style="{StaticResource Lead}" TextWrapping="Wrap"/>
        <Button Content="Review selected capture" Command="{Binding ReviewCommand}" HorizontalAlignment="Left" Margin="0,8,0,6"/>
        <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,8,0,8">
        <Expander Header="Collection completeness — missing data stays unknown"><DataGrid ItemsSource="{Binding Collections}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="220" AutomationProperties.Name="Naming capture collection read states"><DataGrid.Columns><DataGridTextColumn Header="Collection" Binding="{Binding Collection}" Width="190"/><DataGridTextColumn Header="Read state" Binding="{Binding ReadState}" Width="110"/><DataGridTextColumn Header="Objects" Binding="{Binding ReturnedObjects}" Width="80"/><DataGridTextColumn Header="Read detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></Expander>
        <WrapPanel Margin="0,8,0,6">
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Search names, IDs and reasons"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" AutomationProperties.Name="Naming audit display search"/></StackPanel>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Collection"/><ComboBox ItemsSource="{Binding CollectionFilters}" SelectedItem="{Binding CollectionFilter}" Width="180" AutomationProperties.Name="Naming collection display filter"/></StackPanel>
          <StackPanel><TextBlock Text="Ownership evidence"/><ComboBox ItemsSource="{Binding OwnershipFilters}" SelectedItem="{Binding OwnershipFilter}" Width="360" AutomationProperties.Name="Ownership proof display filter"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
      </StackPanel>
      <TabControl Grid.Row="2">
        <TabItem Header="Objects">      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="100" EnableRowVirtualization="True" AutomationProperties.Name="Naming and toolkit ownership results">
        <DataGrid.Columns><DataGridTextColumn Header="Recorded name" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="Collection" Binding="{Binding Collection}" Width="170"/><DataGridTextColumn Header="Naming" Binding="{Binding NamingState}" Width="160"/><DataGridTextColumn Header="Ownership evidence" Binding="{Binding Ownership}" Width="320"/></DataGrid.Columns>
      </DataGrid></TabItem>
        <TabItem Header="Selected object details"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Copy object details" Command="{Binding CopyDetailsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><TextBox Text="{Binding SelectedDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Naming object identity and ownership reason"/></DockPanel></TabItem>
        <TabItem Header="Capture provenance"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Copy capture provenance" Command="{Binding CopyProvenanceCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><TextBox Text="{Binding Provenance, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Naming audit source identity and integrity"/></DockPanel></TabItem>
      </TabControl>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
