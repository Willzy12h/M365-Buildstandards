<UserControl x:Class="BDIT.TenantToolkit.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="05 / SELECT &amp; REVIEW" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Plan changes" Style="{StaticResource H1}"/>
      <TextBlock Text="Choose eligible controls, build a plan and review the exact changes before deployment." Style="{StaticResource Lead}"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="Build plan" Command="{Binding BuildPlanCommand}" VerticalAlignment="Top" Margin="20,0,0,0"/><StackPanel><TextBlock Text="{Binding PlanText}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ContextText}" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
        <Expander Header="Candidate safeguards and plan identity" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0">
          <TextBlock FontSize="12" Text="Conditional Access stays disabled with configured targeting and exclusions. Intune stays unassigned. Matching names do not establish ownership; updates require ownership and drift checks." Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Workspace.Plan.Id, StringFormat='Plan ID: {0}'}" Style="{StaticResource Mono}"/>
          <TextBlock Text="{Binding Workspace.Plan.CreatedAt, StringFormat='Created: {0}'}" Style="{StaticResource Muted}"/>
          <TextBlock Text="{Binding Workspace.Plan.PlanDigest, StringFormat='Digest: {0}'}" Style="{StaticResource Mono}"/>
          <TextBlock Text="{Binding Workspace.Plan.OperatorAccount, StringFormat='Operator: {0}'}" Style="{StaticResource Muted}"/>
        </StackPanel></Expander>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
      <TabItem Header="1  Select controls">
        <DockPanel Margin="0,16,0,0">
          <WrapPanel DockPanel.Dock="Top">
            <Button Content="Select eligible controls" Command="{Binding SelectEligibleCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Style="{StaticResource QuietButton}"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Controls}" IsReadOnly="False" AutomationProperties.Name="Controls to include in the plan">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="66"/>
              <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100" IsReadOnly="True"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" IsReadOnly="True"/>
              <DataGridTextColumn Header="Automation" Binding="{Binding Status}" Width="130" IsReadOnly="True"/>
              <DataGridTextColumn Header="Candidate state" Binding="{Binding SafeState}" Width="125" IsReadOnly="True"/>
              <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="2  Review exact changes">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutomationProperties.Name="Planned actions">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="170"/>
              <DataGridTemplateColumn Header="Action" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Action, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Explanation" Binding="{Binding Reason}" Width="220"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0">
            <TabControl>
              <TabItem Header="Impact &amp; exclusions">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="EXACT CHANGE PREVIEW" Style="{StaticResource Eyebrow}"/>
                    <TextBox Text="{Binding RowDetail, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}"/>
                    <Border Background="{StaticResource WarnBg}" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                      <StackPanel><TextBlock Text="TARGETING &amp; PERSISTENT EXCLUSIONS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Warn}"/><TextBox Text="{Binding ExclusionsText, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Background="Transparent" Padding="0" Margin="0"/></StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Exact payload">
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="Current object" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BeforeJson, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="11" Margin="0"/></DockPanel>
                <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="Payload to be written" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PayloadJson, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="11" Margin="0"/></DockPanel>
              </Grid>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
