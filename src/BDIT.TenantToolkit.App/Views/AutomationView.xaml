<UserControl x:Class="BDIT.TenantToolkit.App.Views.AutomationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:BDIT.TenantToolkit.App.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
  <TextBlock Text="POLICY AUTOMATION" Style="{StaticResource Eyebrow}"/>
  <TextBlock Text="Prepare, create, then activate" Style="{StaticResource H1}"/>
  <TextBlock Text="Creation remains disabled or unassigned. Tenant settings and activation use a separate preview, exact target review and approval. No changes are sent by previewing." Style="{StaticResource Lead}"/>
  <TextBlock Text="Control" Style="{StaticResource FieldLabel}"/>
  <ComboBox ItemsSource="{Binding Controls}" SelectedItem="{Binding SelectedControl}" DisplayMemberPath="Name" AutomationProperties.Name="Automation control"/>
  <TextBlock Text="{Binding Requirements}" Margin="0,12" Style="{StaticResource Muted}"/>
  <views:PrerequisitePanel Items="{Binding SelectedControl.Prerequisites}"/>
  <TabControl>
   <TabItem Header="Readiness checks"><StackPanel Margin="16">
    <TextBlock Text="Identity and service prerequisites" Style="{StaticResource H2}"/>
    <TextBlock Text="Read observed configuration, then complete the ownership and recovery checks. These checks never create accounts, grant roles or accept external service terms." Style="{StaticResource Muted}"/>
    <Button Content="Check readiness" Command="{Binding CheckReadinessCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
    <ItemsControl ItemsSource="{Binding Readiness}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}"><StackPanel>
     <TextBlock FontWeight="SemiBold"><Run Text="{Binding ControlId}"/> · <Run Text="{Binding Status}"/></TextBlock>
     <TextBlock Text="{Binding Detail}" Margin="0,6"/><TextBlock Text="{Binding NextStep}" Style="{StaticResource Muted}"/>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></TabItem>
   <TabItem Header="Policy inputs and imports"><StackPanel Margin="16">
    <TextBlock Text="Client policy inputs" Style="{StaticResource H2}"/>
    <TextBlock Text="Office locations: stable key | name | public CIDR ranges (commas between ranges, one office per line). Keep each key when renaming an office." Style="{StaticResource Muted}"/>
    <TextBox Text="{Binding OfficeLocations, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="65" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Office location names and public ranges"/>
    <TextBlock Text="Fill in what the client has confirmed. Anything left empty either uses the reviewed default shown beside the field, or blocks only the controls that need it. Never enter credentials, tokens or private keys." Style="{StaticResource Muted}"/>
    <ItemsControl ItemsSource="{Binding InputFields}" AutomationProperties.Name="Client policy inputs">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Panel}" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" ToolTip="{Binding Description}"/>
       <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
       <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="90"
                VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Hint}"/>
       <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                  Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="Save inputs" Command="{Binding SaveInputsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
    <Expander Header="Saved input JSON (read-only)" Margin="0,8,0,0">
     <TextBox Text="{Binding PolicyInputs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="120" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saved policy input JSON"/>
    </Expander>
    <TextBlock Text="Import a Graph policy export" Style="{StaticResource H2}" Margin="0,16,0,8"/>
    <TextBlock Text="Disconnect first. Imports create a local candidate standard under the selected tenant's data folder. Source assignments and metadata are removed; foreign GUID values need explicit replacements." Style="{StaticResource Muted}"/>
    <WrapPanel><Button Content="Choose JSON" Command="{Binding ChooseImportCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding ImportFile}" VerticalAlignment="Center"/></WrapPanel>
    <TextBlock Text="Candidate name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CandidateName}" AutomationProperties.Name="Imported candidate name"/>
    <TextBlock Text="Reference replacements: JSON object mapping source GUIDs to target GUIDs" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding Replacements}" AcceptsReturn="True" Height="65" FontFamily="Consolas" AutomationProperties.Name="Foreign reference replacements"/>
    <Button Content="Validate and load local candidate" Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
    <TextBlock Text="Saved candidate standards for this tenant" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
    <ComboBox ItemsSource="{Binding SavedCandidates}" SelectedItem="{Binding SavedCandidate}" AutomationProperties.Name="Saved local candidate standard"/>
    <Button Content="Load saved candidate" Command="{Binding LoadCandidateCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
   </StackPanel></TabItem>
   <TabItem Header="Application packages"><StackPanel Margin="16">
    <TextBlock Text="Publish an approved Win32 package" Style="{StaticResource H2}"/>
    <TextBlock Text="First create the unassigned Win32 candidate with the client's installer filename, installation command, uninstall command and detection rules. Then select the Microsoft Content Prep Tool .intunewin file. No installer is executed on this computer." Style="{StaticResource Muted}"/>
    <WrapPanel><Button Content="Choose .intunewin" Command="{Binding ChoosePackageCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PackageFile}" VerticalAlignment="Center"/></WrapPanel>
    <Button Content="Preview package publication" Command="{Binding PreviewPackageCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" Height="280" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Package publication preview"/>
    <CheckBox IsChecked="{Binding Approved}" Content="I reviewed the app, package hash, commands, detection rules and consequences." Margin="0,12"/>
    <TextBlock Text="Type the target tenant ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TypedTenant}" AutomationProperties.Name="Package tenant confirmation"/>
    <WrapPanel><Button Content="Publish approved package" Command="{Binding PublishPackageCommand}" Style="{StaticResource PrimaryButton}"/>
     <Button Content="Re-verify latest publication" Command="{Binding ReverifyPackageCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
    <TextBlock Text="Encrypted upload URLs and encryption keys stay in memory. Publication records retain app, content-version and file IDs. Assignment is a separate action; undo removes the recorded unassigned app, including its content." Style="{StaticResource Muted}"/>
   </StackPanel></TabItem>
   <TabItem Header="Tenant changes and targeting"><StackPanel Margin="16">
    <Button Content="Capture fresh configuration" Command="{Binding CaptureCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
    <TextBlock Text="Reviewed action" Style="{StaticResource FieldLabel}"/>
    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Reviewed policy action"/>
    <TextBlock Text="Autopilot profiles: generic group assignment and removal are unsupported. Use a separately reviewed dedicated workflow; do not enter group IDs as device IDs. Other assignments require compatible user/device exclusions." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
    <StackPanel Visibility="{Binding IsAssignmentAction, Converter={StaticResource BoolToVis}}" Margin="0,8">
     <TextBlock Text="Assignment population" Style="{StaticResource FieldLabel}"/>
     <ComboBox ItemsSource="{Binding Populations}" SelectedItem="{Binding SelectedPopulation}"
      AutomationProperties.Name="Assignment population" ToolTip="Groups uses the included security group IDs. AllUsers and AllDevices are tenant-wide populations; review exclusions and the exact preview before approving."/>
     <TextBlock Text="Groups uses the included group IDs below. For AllUsers or AllDevices, leave included group IDs empty. Excluded groups remain explicit; a prerequisite exclusion group is not automatically assigned here." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
    </StackPanel>
    <TextBlock Text="MDM policy object ID (MDM action only; activation uses the selected control's recorded ID)" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding ObjectId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MDM policy object ID"/>
    <TextBlock Text="Included security group IDs (one group for TAP)" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding IncludedGroups, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Included group IDs"/>
    <TextBlock Text="Excluded security group IDs (assignment action only)" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding ExcludedGroups, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Excluded group IDs"/>
    <TextBlock Text="Entra device IDs for Autopatch actions (up to 50; captured Windows devices only)" Style="{StaticResource FieldLabel}"/>
    <TextBox Text="{Binding DeviceIds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Autopatch Entra device IDs"/>
    <WrapPanel><Button Content="Preview change" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}"/>
     <Button Content="Preview Entra LAPS enablement" Command="{Binding PreviewLapsCommand}" Style="{StaticResource SecondaryButton}"
      ToolTip="Reads the Entra LAPS tenant prerequisite and previews enabling it. Requires a fresh snapshot. Enablement needs separate deployment approval below."/></WrapPanel>
    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" Height="310" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact change preview"/>
    <Border Background="{StaticResource WarnBg}" Padding="12" Margin="0,12"><StackPanel>
     <CheckBox IsChecked="{Binding Approved}" Content="I reviewed settings, targeting, exclusions, dependencies and consequences."/>
     <TextBlock Text="Type the target tenant ID from the preview" Margin="0,10,0,4"/>
     <TextBox Text="{Binding TypedTenant, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tenant confirmation"/>
     <WrapPanel><Button Content="Apply approved change" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}"/>
      <Button Content="Enable approved Entra LAPS" Command="{Binding ExecuteLapsCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
    </StackPanel></Border>
    <WrapPanel><Button Content="Re-verify latest accepted change" Command="{Binding ReverifyCommand}" Style="{StaticResource SecondaryButton}"/>
     <Button Content="Re-verify latest accepted LAPS change" Command="{Binding ReverifyLapsCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
   </StackPanel></TabItem>
  </TabControl>
  <TextBlock Text="Result and evidence" Style="{StaticResource H2}" Margin="0,18,0,8"/>
  <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="280" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Automation result"/>
 </StackPanel></ScrollViewer>
</UserControl>
