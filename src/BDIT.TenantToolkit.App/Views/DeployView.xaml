<UserControl x:Class="BDIT.TenantToolkit.App.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="06 / DEPLOY &amp; VERIFY" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Deploy reviewed candidates" Style="{StaticResource H1}"/>
      <TextBlock Text="Review prerequisites, confirm the target tenant and track write acceptance separately from verification." Style="{StaticResource Lead}"/>
      <Border Style="{StaticResource WarnPanel}">
        <StackPanel>
          <TextBlock Text="CANDIDATES DO NOT ENFORCE THE STANDARD" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Warn}"/>
          <TextBlock Text="Conditional Access stays disabled. Intune stays unassigned." FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Margin="0,8,0,0" Text="Conditional Access retains its configured targeting, emergency-access exclusions, optional exclusion group and signed-in operator exclusion. The operator exclusion persists until deliberately removed after testing. Review supported updates in the plan; existing objects are never adopted by name. Activation and functional testing remain separate engineering steps."/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="1  Check readiness" Style="{StaticResource H2}"/>
          <TextBlock Text="Complete the required access, capture and evidence steps for this plan." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
          <DataGrid ItemsSource="{Binding Prerequisites}" MaxHeight="250" Margin="0,0,0,16" AutomationProperties.Name="Deployment prerequisites">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Prerequisite" Binding="{Binding Step}" Width="260"/>
              <DataGridTemplateColumn Header="Status" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel>
            <Button Content="Enable deployment access" Command="{Binding EnableDeploymentCommand}" Style="{StaticResource WarningButton}"/>
            <Button Content="Capture configuration" Command="{Binding CaptureCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Export before-change capture" Command="{Binding ExportBeforeCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Acknowledge capture" Command="{Binding AcknowledgeCommand}" Style="{StaticResource SecondaryButton}"/>
          </WrapPanel>
          <TextBlock Text="{Binding LastExport}" Style="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" BorderBrush="#B7CEE6">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Review and deploy" Command="{Binding DeployCommand}" Margin="24,0,0,0" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="2  Confirm the tenant and deploy" Style="{StaticResource H2}"/>
            <TextBlock Text="This writes to the tenant. Confirm its full ID in the next step. The toolkit revalidates the plan and reads each target before a write."/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="3  Verify the outcome" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding RunText}" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button Content="Pause after current action" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Resume" Command="{Binding ResumeCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Stop after current action" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Results}" MaxHeight="360" Margin="0,6,0,12" AutomationProperties.Name="Deployment results">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
              <DataGridTextColumn Header="Planned" Binding="{Binding PlannedAction}" Width="95"/>
              <DataGridTemplateColumn Header="Outcome" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Write acceptance" Binding="{Binding WriteAcceptance}" Width="130"/>
              <DataGridTextColumn Header="Readback" Binding="{Binding Configuration}" Width="100"/>
              <DataGridTextColumn Header="Functional test" Binding="{Binding Verification}" Width="180"/>
              <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="160"/>
              <DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="270"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="A write accepted by Microsoft Graph is not proof of correct configuration or functional behaviour. Review incomplete verification before activation." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button Content="Run report (HTML)" Command="{Binding ExportRunHtmlCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="JSON" Command="{Binding ExportRunJsonCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Excel" Command="{Binding ExportRunXlsxCommand}" Style="{StaticResource SecondaryButton}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
