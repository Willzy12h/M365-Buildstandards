<UserControl x:Class="BDIT.TenantToolkit.App.Views.MailboxCapacityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <UserControl.Resources>
    <Style x:Key="MailboxCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="0"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
    <Style x:Key="MailboxSaved" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding MailboxSupplied}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="LicenceSaved" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding LicenceSupplied}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,6">
          <TextBlock Text="REPORTS / HISTORICAL EVIDENCE" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Mailbox capacity" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding ContextSummary}" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Notice}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,3"/>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
          <TabItem Header="Choose sources">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="10">
                <TextBlock Text="Pair one mailbox inventory with one users/licences report for the selected tenant. Existing source records remain immutable; saved and supplied source claims are unverified." TextWrapping="Wrap" FontSize="12"/>
                <Button Content="Refresh saved source lists" Command="{Binding RefreshSourcesCommand}" HorizontalAlignment="Left" Margin="0,5" ToolTipService.ShowOnDisabled="True" ToolTip="Select a client and wait for the current operation. Listing uses only local evidence."/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Mailbox inventory (Exchange)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding SourceModes}" SelectedItem="{Binding MailboxMode}" Margin="0,3" AutomationProperties.Name="Mailbox source kind"/>
                    <ComboBox ItemsSource="{Binding MailboxRecords}" SelectedItem="{Binding SelectedMailbox}" DisplayMemberPath="Label" Style="{StaticResource MailboxSaved}" Margin="0,3" AutomationProperties.Name="Saved mailbox inventory" ToolTipService.ShowOnDisabled="True" ToolTip="Choose Saved record to select this tenant's stored mailbox inventory."/>
                    <TextBlock Text="{Binding SelectedMailbox.Problem}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="{Binding MailboxListing}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="Supplied mailbox file" FontSize="12" Margin="0,5,0,0"/>
                    <TextBox Text="{Binding MailboxFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" AutomationProperties.Name="Supplied mailbox inventory path" IsEnabled="{Binding MailboxSupplied}" ToolTipService.ShowOnDisabled="True" ToolTip="Choose Supplied file to enter this path, or use Choose mailbox file."/>
                    <Button Content="Choose mailbox file…" Command="{Binding ChooseMailboxCommand}" HorizontalAlignment="Left" Margin="0,3" ToolTipService.ShowOnDisabled="True" ToolTip="Select a client and wait for the current operation. File choice performs no reads until Review."/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Users and assigned licences (Graph)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding SourceModes}" SelectedItem="{Binding LicenceMode}" Margin="0,3" AutomationProperties.Name="Licence source kind"/>
                    <ComboBox ItemsSource="{Binding LicenceRecords}" SelectedItem="{Binding SelectedLicence}" DisplayMemberPath="Label" Style="{StaticResource LicenceSaved}" Margin="0,3" AutomationProperties.Name="Saved users and licences" ToolTipService.ShowOnDisabled="True" ToolTip="Choose Saved record to select this tenant's stored users/licences report."/>
                    <TextBlock Text="{Binding SelectedLicence.Problem}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="{Binding LicenceListing}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="Supplied licence file" FontSize="12" Margin="0,5,0,0"/>
                    <TextBox Text="{Binding LicenceFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" AutomationProperties.Name="Supplied users and licences path" IsEnabled="{Binding LicenceSupplied}" ToolTipService.ShowOnDisabled="True" ToolTip="Choose Supplied file to enter this path, or use Choose licence file."/>
                    <Button Content="Choose licence file…" Command="{Binding ChooseLicenceCommand}" HorizontalAlignment="Left" Margin="0,3" ToolTipService.ShowOnDisabled="True" ToolTip="Select a client and wait for the current operation. File choice performs no reads until Review."/>
                  </StackPanel>
                </Grid>
                <Button Content="Review selected source pair" Command="{Binding ReviewCommand}" HorizontalAlignment="Left" Margin="0,6" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ReviewGuidance}"/>
                <TextBlock Text="{Binding ReviewGuidance}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="Each file has its existing 32 MiB strict-reader limit. Listings inspect at most 200 entries and 64 MiB per source folder; incomplete listings and damaged files retain explicit reasons. Neither a missing folder nor an unreadable source proves an empty tenant." FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Results">
            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding SourceTimes}" TextWrapping="Wrap" FontSize="11" Margin="0,3"/></StackPanel>
              <StackPanel Grid.Row="1">
                <WrapPanel Margin="0,3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Search names, SMTP, IDs and reasons" FontSize="12"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,2" AutomationProperties.Name="Mailbox capacity display search"/></StackPanel><StackPanel><TextBlock Text="Entitlement" FontSize="12"/><ComboBox ItemsSource="{Binding EntitlementFilters}" SelectedItem="{Binding EntitlementFilter}" Width="190" Margin="0,2" AutomationProperties.Name="Mailbox entitlement display filter"/></StackPanel></WrapPanel>
                <TextBlock Text="{Binding FilterSummary}" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
              </StackPanel>
              <TabControl Grid.Row="2">
                <TabItem Header="Mailboxes"><DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" RowHeight="36" MinRowHeight="36" MinHeight="150" AutomationProperties.Name="Mailbox capacity results"><DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource MailboxCell}"/>
                  <DataGridTextColumn Header="Primary SMTP" Binding="{Binding Smtp}" Width="190" ElementStyle="{StaticResource MailboxCell}"/>
                  <DataGridTextColumn Header="100 GB?" Binding="{Binding Configured}" Width="80" ElementStyle="{StaticResource MailboxCell}"/>
                  <DataGridTextColumn Header="Entitlement" Binding="{Binding Entitlement}" Width="125" ElementStyle="{StaticResource MailboxCell}"/>
                  <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="185" ElementStyle="{StaticResource MailboxCell}"/>
                  <DataGridTextColumn Header="Read state" Binding="{Binding ReadState}" Width="95" ElementStyle="{StaticResource MailboxCell}"/>
                </DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Selected mailbox details"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Copy mailbox details" Command="{Binding CopyRowCommand}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="Review the current source pair and select a mailbox to copy exact IDs, raw values and read reasons."/><TextBox Text="{Binding SelectedDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mailbox identities raw quotas and archive details"/></DockPanel></TabItem>
              </TabControl>
              <StackPanel Grid.Row="3" Margin="0,3,0,0"><WrapPanel><Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" Margin="0,2,6,2" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExportGuidance}"/><Button Content="Export CSV ZIP" Command="{Binding ExportCsvCommand}" Margin="0,2,6,2" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExportGuidance}"/><Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,2,6,2" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExportGuidance}"/><Button Content="Export Excel" Command="{Binding ExportXlsxCommand}" Margin="0,2" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExportGuidance}"/></WrapPanel><TextBlock Text="{Binding ExportGuidance}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding LastExport}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="Source provenance and limits"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Copy both source provenances" Command="{Binding CopyProvenanceCommand}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ExportGuidance}"/><TextBox Text="{Binding Provenance, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mailbox and licence source timestamps digests and limitations"/></DockPanel></TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
