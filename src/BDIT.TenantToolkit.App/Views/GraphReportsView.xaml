<UserControl x:Class="BDIT.TenantToolkit.App.Views.GraphReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="REPORTS / READ-ONLY" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Tenant reports" Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding ContextSummary}" TextWrapping="Wrap" Style="{StaticResource Lead}"/>
      </StackPanel>
      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="0,8,0,0">
        <TabItem Header="Read a report"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,8">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="Report"/><ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Name" Width="300" AutomationProperties.Name="Registered report"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="Start UTC (logs only)"/><TextBox Text="{Binding StartUtc, UpdateSourceTrigger=PropertyChanged}" Width="200" IsEnabled="{Binding RequiresDates}" AutomationProperties.Name="Requested UTC start" ToolTip="UTC ISO timestamp, for example 2026-09-01T00:00:00Z. Clear dates for non-log reports."/></StackPanel>
            <StackPanel Margin="0,0,0,6"><TextBlock Text="End UTC (logs only)"/><TextBox Text="{Binding EndUtc, UpdateSourceTrigger=PropertyChanged}" Width="200" IsEnabled="{Binding RequiresDates}" AutomationProperties.Name="Requested UTC end" ToolTip="UTC ISO timestamp, after start, no later than now; maximum 31 days."/></StackPanel>
          </WrapPanel>
          <Expander Header="Required permissions, limits and current access">
            <StackPanel><TextBlock Text="{Binding ScopeExplanation}" TextWrapping="Wrap" Margin="0,8,0,6"/><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap"/></StackPanel>
          </Expander>
          <CheckBox IsChecked="{Binding ReadAcknowledged}" Margin="0,10,0,6"><TextBlock Text="I acknowledge this experimental read and its stated limits. This grants no consent or tenant-change approval." TextWrapping="Wrap"/></CheckBox>
          <WrapPanel><Button Content="Read selected report" Command="{Binding ReadCommand}"/><Button Content="Stop read" Command="{Binding StopReadCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
          <TextBlock Text="{Binding ReadGuidance}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
        </ScrollViewer></TabItem>
        <TabItem Header="Results">
          <Grid Margin="12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0">
        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
        <WrapPanel Margin="0,8,0,6">
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Section"/><ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Width="180" AutomationProperties.Name="Report section"/></StackPanel>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Search visible values"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="270" AutomationProperties.Name="Report display search"/></StackPanel>
          <StackPanel><TextBlock Text="Row read state"/><ComboBox ItemsSource="{Binding RowStates}" SelectedItem="{Binding RowState}" Width="150" AutomationProperties.Name="Row read state display filter"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding SectionSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
      </StackPanel>
      <TabControl Grid.Row="1" Margin="0,4,0,0">
        <TabItem Header="Rows">      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinHeight="100" EnableRowVirtualization="True" EnableColumnVirtualization="True" ColumnWidth="SizeToHeader" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Typed report rows"/>
        </TabItem>
        <TabItem Header="Selected row details"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Copy row details" Command="{Binding CopyRowCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><TextBox Text="{Binding SelectedRowDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected report row identity and read details"/></DockPanel></TabItem>
        <TabItem Header="Provenance and limits"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="Copy provenance" Command="{Binding CopyDetailsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><TextBlock DockPanel.Dock="Top" Text="{Binding ProvenanceNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox Text="{Binding Details, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Report provenance and source claims"/></DockPanel></TabItem>
      </TabControl>
      <StackPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock Text="{Binding FilterSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="HTML report" Command="{Binding ExportHtmlCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="JSON evidence" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="CSV ZIP" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Excel XLSX" Command="{Binding ExportXlsxCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Open export folder" Command="{Binding OpenExportCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
        <TextBlock Text="{Binding ExportGuidance}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11"/>
        <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="11" MaxHeight="48" VerticalScrollBarVisibility="Auto" Padding="0" MinHeight="0" Margin="0,4,0,0" AutomationProperties.Name="Complete report export output path"/>
      </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Saved evidence"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel Margin="0,8,0,0">
            <WrapPanel><Button Content="Refresh saved reports" Command="{Binding RefreshStoredCommand}" Style="{StaticResource SecondaryButton}"/><ComboBox ItemsSource="{Binding StoredReports}" SelectedItem="{Binding SelectedStored}" DisplayMemberPath="Label" Width="460" AutomationProperties.Name="Saved report record" Margin="0,0,8,0"/><Button Content="Open saved report" Command="{Binding OpenStoredCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
            <TextBlock Text="Refresh the offline list and select a readable record before opening saved evidence. Select a client and enter or choose a JSON path before opening supplied evidence." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,6,0,6"/>
            <TextBlock Text="{Binding StoredStatus}" TextWrapping="Wrap" Margin="0,4,0,4"/>
            <TextBlock Text="{Binding SelectedStored.Problem}" TextWrapping="Wrap"/>
            <WrapPanel><TextBox Text="{Binding SuppliedFile, UpdateSourceTrigger=PropertyChanged}" Width="460" AutomationProperties.Name="Supplied Graph report JSON path" Margin="0,0,8,0"/><Button Content="Choose JSON" Command="{Binding ChooseSuppliedCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Open supplied JSON" Command="{Binding OpenSuppliedCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
            <TextBlock Text="Strict schema 1 Graph evidence only, at most 32 MiB; the selected tenant is fixed. Invalid digest, wrong tenant, links, Exchange reports and configuration snapshots are refused." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </StackPanel>
        </ScrollViewer></TabItem>
      </TabControl>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
