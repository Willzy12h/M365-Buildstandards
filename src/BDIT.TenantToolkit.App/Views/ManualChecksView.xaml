<UserControl x:Class="BDIT.TenantToolkit.App.Views.ManualChecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="EVIDENCE &amp; HANDOVER" Style="{StaticResource Eyebrow}"/><TextBlock Text="Manual checks" Style="{StaticResource H1}"/><TextBlock Text="{Binding ContextText}" Style="{StaticResource Lead}"/></StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Manual checks">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="190"/>
          <DataGridTemplateColumn Header="Outcome" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
          <DataGridTextColumn Header="Evidence note" Binding="{Binding Note}" Width="220"/>
          <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAt}" Width="160"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="RECORD EVIDENCE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedText}" Margin="0,0,0,20"/>
          <TextBlock Text="Outcome" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding EditStatus, Mode=TwoWay}" AutomationProperties.Name="Manual check outcome"/>
          <TextBlock Text="Evidence note" Style="{StaticResource FieldLabel}"/><TextBlock Text="Describe what was checked and where the evidence is held." Style="{StaticResource Muted}" Margin="0,0,0,8"/>
          <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="160" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Manual check evidence"/>
          <Button Content="Save evidence" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
