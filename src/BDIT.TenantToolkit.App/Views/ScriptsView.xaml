<UserControl x:Class="BDIT.TenantToolkit.App.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <!-- A filling page: the library list and the form share the height under the tenant banner and scroll inside
       themselves. Below PageLayout.MinimumHeight the whole page scrolls instead, as the other filling pages do. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="REVIEWED LIBRARY" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Scripts &amp; Reports" Style="{StaticResource H1}"/>
          <TextBlock Text="Fill in a form and confirm the tenant. Run a read-only item here against the connected client, or copy or save the script to run yourself. Nothing runs without your confirmation, and nothing runs by itself." Style="{StaticResource Lead}" Margin="0,0,0,14"/>
        </StackPanel>

        <!-- Which tenant a copied script is for, always in view. The colour is a recognition cue beside the name and ID. -->
        <Border Grid.Row="1" Background="{Binding BannerBrush}" BorderBrush="{Binding BannerLineBrush}" BorderThickness="1" CornerRadius="6" Padding="18,10" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding BannerTitle}" Foreground="{Binding BannerTextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding BannerTitle}"/>
              <TextBlock Text="{Binding BannerTenantId}" Foreground="{Binding BannerTextBrush}" FontFamily="Consolas" FontSize="13" Margin="0,3,0,0" Visibility="{Binding HasTenant, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding BannerNote}" Foreground="{Binding BannerTextBrush}" FontWeight="SemiBold" MaxWidth="360" TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Search" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search the library" ToolTip="Words in the name, area, description or keywords" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
              <TextBlock Text="{Binding LibraryError}" Foreground="{StaticResource Danger}" Margin="0,0,0,8" Visibility="{Binding HasLibraryError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Library items">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" Margin="6,10,0,4"/></DataTemplate></GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="{StaticResource GoodBg}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Good}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Actions}" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Needs}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Muted}" FontStyle="Italic" Margin="0,3,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <WrapPanel>
                  <Button Content="Copy script…" Command="{Binding CopyScriptCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Confirm the tenant and values, then put the script on the clipboard"/>
                  <!-- Run is shown only for read-only items (INT-072 keeps changes copy only) and always asks for the same confirmation. -->
                  <Button Content="Run…" Command="{Binding RunScriptCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding ShowsRun, Converter={StaticResource BoolToVis}}"
                          ToolTip="Confirm the tenant, account and values, then run this read-only item against the connected client"/>
                  <Button Content="Cancel run" Command="{Binding CancelRunCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                          ToolTip="Stop the PowerShell process. Nothing is kept from a stopped run."/>
                  <Button Content="Save as .ps1…" Command="{Binding SaveScriptCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Confirm the tenant and values, then save the script as a new file"/>
                </WrapPanel>
                <TextBlock Text="{Binding CopyBlockedText}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding RunBlockedText}" Style="{StaticResource Muted}" Visibility="{Binding ShowsRun, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Good}" FontWeight="SemiBold" Margin="0,4,0,0"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="{Binding SelectedHeading}" Style="{StaticResource H2}"/>
                  <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding Limitations}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                  <TextBlock Text="FORM" Style="{StaticResource Eyebrow}" Margin="0,16,0,8" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                  <ItemsControl ItemsSource="{Binding Fields}" AutomationProperties.Name="Script form" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                          <TextBlock Text="{Binding LabelText}" Style="{StaticResource FieldLabel}" Visibility="{Binding ShowsLabel, Converter={StaticResource BoolToVis}}"/>
                          <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Hint}" Margin="0,0,0,4"
                                   Visibility="{Binding IsTextEntry, Converter={StaticResource BoolToVis}}"/>
                          <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Hint}" Margin="0,0,0,4"
                                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                   Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}"/>
                          <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,4,0,4" Visibility="{Binding IsFlag, Converter={StaticResource BoolToVis}}"/>
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Text" AutomationProperties.Name="{Binding Label}" Margin="0,0,0,4"
                                    Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
                          <ItemsControl ItemsSource="{Binding Choices}" IsTabStop="False" Visibility="{Binding IsChoices, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Text}" Margin="0,2,16,6"/></DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}"/>
                          <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}"/>
                          <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Danger}" Margin="0,3,0,0" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Background="{StaticResource DangerBg}" CornerRadius="6" Padding="12,10" Margin="0,4,0,10" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                      <TextBlock Text="Before this script can be copied" Foreground="{StaticResource Danger}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                      <ItemsControl ItemsSource="{Binding Problems}" IsTabStop="False">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Danger}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="COMMAND PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,6,0,6" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                  <TextBox Text="{Binding Preview, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="12" MinHeight="90"
                           AutomationProperties.Name="Command preview" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>

                  <!-- This session's runs. Each is also kept in the client's run history folder; a stopped run keeps no rows. -->
                  <StackPanel Margin="0,16,0,0" Visibility="{Binding HasRunHistory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="RUNS THIS SESSION" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RunStatus}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding RunHistory}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}" MaxHeight="140" AutomationProperties.Name="Runs this session">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding When, Mode=OneWay}"/>  <Run Text="{Binding ItemName, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding SelectedRun.Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding SelectedRun.Detail}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding SelectedRun.PreviewText}" Style="{StaticResource Muted}" Margin="0,4,0,6"/>
                      <DataGrid ItemsSource="{Binding SelectedRun.Preview}" AutoGenerateColumns="True" MaxHeight="320" AutomationProperties.Name="Run results preview"
                                Visibility="{Binding SelectedRun.HasRows, Converter={StaticResource BoolToVis}}"/>
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="Export CSV" Command="{Binding ExportRunCsvCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Write every kept row to a new CSV in the reports folder"/>
                        <Button Content="Open folder" Command="{Binding OpenRunFolderCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Show this run's record in the client's run history folder"/>
                      </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
