<UserControl x:Class="BDIT.TenantToolkit.App.Views.AssessmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <!-- The page fills the window down to a minimum height, then scrolls: a short window (a laptop at 150% scaling)
       would otherwise squeeze the tables and guidance below it out of reach. See PageLayout.MinimumHeight. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="03 / COMPARE WITH THE STANDARD" Style="{StaticResource Eyebrow}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Re-run assessment" Command="{Binding ReassessCommand}" VerticalAlignment="Top" Margin="20,0,0,0"/><TextBlock Text="Assessment" Style="{StaticResource H1}"/></DockPanel>
          <TextBlock Text="Review property-level matches, gaps and unknown results. Select a finding to inspect the supporting evidence." Style="{StaticResource Lead}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding SummaryText}" FontSize="12"/>
            <ItemsControl ItemsSource="{Binding Limitations}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Expander Header="Export assessment reports" Margin="0,6,0,0">
              <StackPanel Margin="0,8,0,0">
                <WrapPanel>
                  <Button Content="Engineer report (HTML)" Command="{Binding ExportHtmlCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Client summary (HTML)" Command="{Binding ExportClientCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Excel" Command="{Binding ExportXlsxCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="CSV (zip)" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Open export folder" Command="{Binding OpenExportCommand}" Style="{StaticResource QuietButton}"/>
                </WrapPanel>
                <TextBox AutomationProperties.Name="Last exported report" Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MinHeight="0" Padding="0" Margin="0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock Text="Area" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AreaFilters}" SelectedItem="{Binding FilterArea, Mode=TwoWay}" AutomationProperties.Name="Filter assessment area"/></StackPanel>
            <Grid DockPanel.Dock="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="Result" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FilterStatus, Mode=TwoWay}" AutomationProperties.Name="Filter results"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Category" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding FilterCategory, Mode=TwoWay}" AutomationProperties.Name="Filter category"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Search" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search findings"/></StackPanel>
            </Grid>
            <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Assessment findings">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Control" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ControlId}" Style="{StaticResource Mono}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Result" Width="160" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusKey, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0">
            <TabControl>
              <TabItem Header="Finding evidence"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel>
                <TextBox AutomationProperties.Name="Selected finding detail" Text="{Binding SelectedDetail, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Margin="0,0,0,4"/>
                <Button Content="Copy finding detail" Command="{Binding CopyDetailCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Compare settings"><DockPanel Margin="0,12,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Matching or overlapping object" Style="{StaticResource FieldLabel}"/>
              <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Matching object"/>
              <TextBlock DockPanel.Dock="Top" Text="{Binding CandidateText}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
              <Expander DockPanel.Dock="Bottom" Header="Proposed candidate JSON" Margin="0,8,0,0"><TextBox AutomationProperties.Name="Proposed payload" Text="{Binding ProposedJson, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="11" Height="150" Margin="0,8,0,0"/></Expander>
              <DataGrid ItemsSource="{Binding Differences}" AutomationProperties.Name="Property comparison">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="*"/>
                  <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*"/>
                  <DataGridTextColumn Header="Standard" Binding="{Binding Standard}" Width="*"/>
                  <DataGridCheckBoxColumn Header="Match" Binding="{Binding Match}" Width="65"/>
                </DataGrid.Columns>
              </DataGrid>
              </DockPanel></TabItem>
            </TabControl>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
