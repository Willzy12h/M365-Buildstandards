<Window x:Class="BDIT.TenantToolkit.App.Views.ConfirmTenantDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm tenant deployment" Width="760" Height="700" MinHeight="620" MinWidth="680" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource BgWindow}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="FINAL TENANT CONFIRMATION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Confirm the reviewed changes" Style="{StaticResource H1}"/><TextBlock Text="This action writes to Microsoft 365. Check the tenant and changes below." Style="{StaticResource Lead}"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource WarnPanel}" Padding="16"><TextBlock x:Name="SummaryText"/></Border>
    <ListBox Grid.Row="2" x:Name="ChangeList" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Changes to deploy"/>
    <StackPanel Grid.Row="3" Margin="0,20,0,0">
      <TextBlock Text="Verified target tenant ID" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="TenantIdText" Style="{StaticResource Mono}" Margin="0,4,0,8"/>
      <CheckBox x:Name="ApprovalBox" Checked="OnApprovalChanged" Unchecked="OnApprovalChanged" AutomationProperties.Name="Approve this tenant and the listed changes"><TextBlock Text="I have reviewed this organisation, signed-in account and every listed change. I approve deployment to this tenant." TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="Conditional Access remains disabled with the reviewed targeting and exclusions. Intune candidates remain unassigned. Activation and functional testing are separate steps." Style="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="OnCancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button x:Name="DeployButton" Content="Approve and deploy reviewed changes" Click="OnConfirm" IsEnabled="False" Margin="0"/></StackPanel>
  </Grid>
</Window>
