<UserControl x:Class="BDIT.TenantToolkit.App.Views.ApplicationSetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="CONNECTION SETUP" Style="{StaticResource Eyebrow}"/><TextBlock Text="Set up tenant applications" Style="{StaticResource H1}"/>
      <TextBlock Text="One setup wizard, two clearly named apps: Assessment keeps a read-only permission boundary; Deployment requests the write permissions needed for approved plans." Style="{StaticResource Lead}"/>
      <Border Style="{StaticResource WarnPanel}">
        <StackPanel><TextBlock Text="PRIVILEGED SETUP IS A SEPARATE SESSION" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Warn}"/><TextBlock Text="{Binding SetupIdentity}" FontWeight="SemiBold"/><TextBlock Text="Review and approve each tenant change. Setup can create or repair dedicated tool registrations, set their icon and URLs, and assign the current engineer. It never grants directory roles or creates secrets." Margin="0,8,0,0"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="1  Authorise the setup session" Style="{StaticResource H2}"/>
          <TextBlock Text="Use an account with a suitable Cloud Application Administrator or Application Administrator role to create registrations. Administrator consent has separate role requirements and is reviewed later. The toolkit does not grant directory roles." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <Border Background="{StaticResource WarnBg}" CornerRadius="5" Padding="14" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="SETUP PERMISSIONS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Warn}"/>
            <TextBlock Text="User.Read — read the signed-in identity."/>
            <TextBlock Text="Application.ReadWrite.All — read and manage application registrations." Margin="0,5,0,0"/>
            <TextBlock Text="Directory.Read.All — inspect directory metadata, grants and assignments." Margin="0,5,0,0"/>
            <TextBlock Text="AppRoleAssignment.ReadWrite.All — assign the approved engineer to the tool enterprise apps." Margin="0,5,0,0"/>
            <TextBlock Text="These four setup permissions belong to Microsoft Graph Command Line Tools. They are not the assessment or deployment app permissions, which you approve in step 4." FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="Microsoft shows the consent request during setup sign-in. The local session is temporary; consent granted in Microsoft Entra can persist after disconnecting and must be reviewed or revoked separately." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Target tenant ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Application setup tenant ID"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Application name prefix" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Application name prefix"/></StackPanel></Grid>
          <CheckBox Content="Use external browser instead of Windows sign-in" IsChecked="{Binding UseSystemBrowser, Mode=TwoWay}"/>
          <CheckBox IsChecked="{Binding SetupApproved, Mode=TwoWay}"><TextBlock Text="I authorise a privileged setup sign-in for this tenant to inspect and prepare application registrations."/></CheckBox>
          <WrapPanel><Button Content="Sign in for application setup" Command="{Binding ConnectCommand}" Style="{StaticResource WarningButton}"/><Button Content="Disconnect setup session" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Content="Preview applications" Command="{Binding PreviewCommand}" Margin="20,0,0,0"/><TextBlock Text="2  Review applications and permissions" Style="{StaticResource H2}"/></DockPanel>
          <TextBlock Text="Leave IDs blank to create new apps. To repair existing dedicated tool apps, enter their exact client IDs here. Review all replacement settings before approval." Style="{StaticResource Muted}" Margin="0,12,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Assessment Tool — existing client ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AssessmentClientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Existing assessment tool ID"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Deployment Tool — existing client ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DeploymentClientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Existing deployment tool ID"/></StackPanel></Grid>
          <CheckBox IsChecked="{Binding AssignOperator, Mode=TwoWay}"><TextBlock Text="Include assigning the signed-in setup engineer to both enterprise apps (does not grant administrator roles)."/></CheckBox>
          <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Muted}" Margin="0,10,0,16"/>
          <DataGrid ItemsSource="{Binding PlanRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MaxHeight="230" Margin="0,0,0,16" AutomationProperties.Name="Proposed applications"><DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="250"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="120"/><DataGridTextColumn Header="Action" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
          <TextBlock Text="Permissions for the selected application" Style="{StaticResource FieldLabel}"/>
          <DataGrid ItemsSource="{Binding Permissions}" MaxHeight="360" Margin="0,0,0,12" AutomationProperties.Name="Requested delegated permissions"><DataGrid.Columns><DataGridTextColumn Header="Permission" Binding="{Binding Name}" Width="300"/><DataGridTextColumn Header="What it permits" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="Admin consent" Binding="{Binding AdminConsentRequired}" Width="115"/></DataGrid.Columns></DataGrid>
          <Expander Header="Exact application registration payload"><TextBox AutomationProperties.Name="Permissions for the selected application" Text="{Binding SelectedPayload, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="12" Height="260" Margin="0,10,0,0"/></Expander>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="3  Approve setup changes" Style="{StaticResource H2}"/>
          <TextBlock Text="Review both applications and their permissions above. Existing IDs permit only the displayed dedicated-tool repairs. Each write has before-change evidence and a recorded outcome; name matches alone never establish ownership." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
          <CheckBox IsChecked="{Binding PermissionsApproved, Mode=TwoWay}"><TextBlock Text="I approve the previewed registration changes, delegated permission configuration, branding and selected engineer assignment."/></CheckBox>
          <TextBlock Text="Type the target tenant ID in full" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Confirm application setup tenant ID"/>
          <Button Content="Apply approved setup" Command="{Binding CreateCommand}" HorizontalAlignment="Left"/><TextBlock Text="Each application shows its full outcome and every configuration, icon and engineer-assignment write. Creation results apply only to new apps." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0" AutomationProperties.Name="Application setup results"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Padding="16" Margin="0,0,0,12" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><StackPanel>
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Margin="0,5,0,8" FontFamily="Consolas" FontSize="11"><Run Text="Client ID: "/><Run Text="{Binding ClientId, Mode=OneWay}"/></TextBlock>
              <TextBlock FontWeight="SemiBold"><Run Text="Outcome: "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,5,0,8"><Run Text="Configuration verification: "/><Run Text="{Binding ConfigurationVerification, Mode=OneWay}"/></TextBlock>
              <TextBlock Text="{Binding Reason}" Margin="0,0,0,8"/>
              <Expander Header="Each write outcome" IsExpanded="True"><StackPanel Margin="0,8,0,0">
                <TextBlock><Run Text="New registration creation: "/><Run Text="{Binding ApplicationWrite, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5,0,0"><Run Text="New enterprise app creation: "/><Run Text="{Binding ServicePrincipalWrite, Mode=OneWay}"/></TextBlock>
                <ItemsControl ItemsSource="{Binding AdditionalWrites}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,5,0,0"><Run Text="{Binding Action, Mode=OneWay}"/>: <Run Text="{Binding Acceptance, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></Expander>
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="4  Complete consent and engineer access" Style="{StaticResource H2}"/>
          <TextBlock Text="Approve Microsoft's full permission list for each app below. Setup fills the client IDs automatically. Consent is checked against actual Graph grants, not the browser success message." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Assessment application (client) ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AssessmentClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Setup assessment client ID"/><Button Content="Review assessment consent" Command="{Binding AssessmentConsentCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Deployment application (client) ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DeploymentClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Setup deployment client ID"/><Button Content="Review deployment consent" Command="{Binding DeploymentConsentCommand}" Style="{StaticResource WarningButton}" HorizontalAlignment="Left"/></StackPanel></Grid>
          <Button Content="Open Entra for additional engineers or delegated-admin access" Command="{Binding OpenEntraCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Content="Validate setup" Command="{Binding ValidateCommand}" Margin="20,0,0,0"/><TextBlock Text="5  Validate and use the application IDs" Style="{StaticResource H2}"/></DockPanel>
          <TextBlock Text="Validation shows exactly which scopes are required, granted or missing, and whether the current engineer is assigned. Continue directly with an application once it is ready." Style="{StaticResource Muted}" Margin="0,10,0,16"/>
          <ItemsControl ItemsSource="{Binding Validations}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}" Background="{StaticResource BgPanel}" Padding="16">
              <StackPanel>
                <TextBlock Text="{Binding Mode}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ClientId}" Style="{StaticResource Mono}" Margin="0,4,0,12"/>
                <WrapPanel>
                  <TextBlock Margin="0,0,24,8" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Configuration: needs attention"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding ConfigurationValid}" Value="True"><Setter Property="Text" Value="Configuration: verified"/><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  <TextBlock Margin="0,0,24,8" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Consent: needs attention"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding ConsentComplete}" Value="True"><Setter Property="Text" Value="Consent: verified"/><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  <TextBlock Margin="0,0,0,8" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Engineer assignment: needs attention"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding EngineerAssignmentConfirmed}" Value="True"><Setter Property="Text" Value="Engineer assignment: verified"/><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </WrapPanel>
                <TextBlock Text="{Binding PermissionSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding MissingScopes}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding EngineerAssignmentStatus}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Danger}" Margin="0,3,0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding AccessStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Expander Header="Configured and granted scopes" Margin="0,8,0,0"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Configured" Style="{StaticResource FieldLabel}"/><ItemsControl ItemsSource="{Binding ConfiguredScopes}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Granted" Style="{StaticResource FieldLabel}"/><ItemsControl ItemsSource="{Binding GrantedScopes}"/></StackPanel></Grid></Expander>
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Partner/GDAP or group access may not appear as a direct assignment. The delegated-admin check signs in to the selected tenant and lets Microsoft enforce access; it grants no roles or permissions." Style="{StaticResource Muted}" Margin="0,12,0,8"/>
          <WrapPanel><Button Content="Continue read-only" Command="{Binding ContinueAssessmentCommand}"/><Button Content="Continue to deployment" Command="{Binding ContinueDeploymentCommand}" Style="{StaticResource WarningButton}"/><Button Content="Check delegated-admin deployment access" Command="{Binding CheckDelegatedAdminCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Return to connection details" Command="{Binding ApplyIdsCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoft}"><StackPanel><TextBlock Text="SETUP OUTCOME &amp; NEXT STEPS" Style="{StaticResource Eyebrow}"/><TextBox AutomationProperties.Name="Setup outcome and next steps" Text="{Binding Outcome, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Background="Transparent" Padding="0" Margin="0"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
