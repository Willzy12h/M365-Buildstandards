<UserControl x:Class="BDIT.TenantToolkit.App.Views.ApplicationSetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="CONNECTION SETUP" Style="{StaticResource Eyebrow}"/><TextBlock Text="Set up this tenant" Style="{StaticResource H1}"/>
      <TextBlock Text="Three steps: sign in as an administrator, approve the two tool applications and their permissions, then connect. The toolkit creates both applications, opens Microsoft's approval for each in turn and checks the result itself. Assessment keeps a read-only permission boundary; Deployment holds the write permissions approved plans need." Style="{StaticResource Lead}"/>
      <Border Style="{StaticResource WarnPanel}">
        <StackPanel><TextBlock Text="PRIVILEGED SETUP IS A SEPARATE SESSION" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Warn}"/><TextBlock Text="{Binding SetupIdentity}" FontWeight="SemiBold"/><TextBlock Text="The toolkit changes nothing in the tenant until you approve it in step 2. Setup creates or repairs the two dedicated tool applications, sets their icon and URLs and, if chosen, assigns you to them. It never grants directory roles or creates secrets." Margin="0,8,0,0"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoft}"><TextBlock Text="{Binding NextStep}" FontWeight="SemiBold"/></Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="1  Sign in as an administrator" Style="{StaticResource H2}"/>
          <TextBlock Text="Use an account in the client's tenant that can create applications and grant tenant-wide consent. Microsoft first asks you to accept four temporary setup permissions, listed below; they belong to Microsoft Graph Command Line Tools, not to the tool's own applications." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <Border Background="{StaticResource WarnBg}" CornerRadius="5" Padding="14" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="SETUP PERMISSIONS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Warn}"/>
            <TextBlock Text="User.Read — read the signed-in identity."/>
            <TextBlock Text="Application.ReadWrite.All — read and manage application registrations." Margin="0,5,0,0"/>
            <TextBlock Text="Directory.Read.All — inspect directory metadata, grants and assignments." Margin="0,5,0,0"/>
            <TextBlock Text="AppRoleAssignment.ReadWrite.All — assign the approved engineer to the tool enterprise apps." Margin="0,5,0,0"/>
            <TextBlock Text="The setup session is temporary and never saved. Consent granted in Microsoft Entra can persist after disconnecting and must be reviewed or revoked there." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <TextBlock Text="Client tenant ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MaxWidth="460" HorizontalAlignment="Left" MinWidth="360" AutomationProperties.Name="Application setup tenant ID"/>
          <CheckBox AutomationProperties.Name="Assign me to both applications so I can connect straight away" IsChecked="{Binding AssignOperator, Mode=TwoWay}"><TextBlock Text="Assign me to both applications so I can connect straight away (grants no administrator role). Other engineers are assigned in Entra." TextWrapping="Wrap"/></CheckBox>
          <CheckBox Content="Use external browser instead of Windows sign-in" IsChecked="{Binding UseSystemBrowser, Mode=TwoWay}"/>
          <WrapPanel><Button Content="Sign in as administrator" Command="{Binding ConnectCommand}" Style="{StaticResource WarningButton}"/><Button Content="Disconnect setup session" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Content="Preview again" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="20,0,0,0"/><TextBlock Text="2  Review and approve" Style="{StaticResource H2}"/></DockPanel>
          <TextBlock Text="Signing in shows this automatically. Check the tenant name first, then both applications; select an application to see every permission it will ask Microsoft for." Style="{StaticResource Muted}" Margin="0,12,0,12"/>
          <TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <DataGrid ItemsSource="{Binding PlanRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MaxHeight="230" Margin="0,0,0,16" AutomationProperties.Name="Proposed applications"><DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="250"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="120"/><DataGridTextColumn Header="Action" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
          <TextBlock Text="Permissions for the selected application" Style="{StaticResource FieldLabel}"/>
          <DataGrid ItemsSource="{Binding Permissions}" MaxHeight="360" Margin="0,0,0,12" AutomationProperties.Name="Requested delegated permissions"><DataGrid.Columns><DataGridTextColumn Header="Permission" Binding="{Binding Name}" Width="300"/><DataGridTextColumn Header="What it permits" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="Admin consent" Binding="{Binding AdminConsentRequired}" Width="115"/></DataGrid.Columns></DataGrid>
          <Expander Header="Exact application registration payload"><TextBox AutomationProperties.Name="Exact application registration payload" Text="{Binding SelectedPayload, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="12" Height="260" Margin="0,10,0,0"/></Expander>
          <CheckBox AutomationProperties.Name="I approve these applications and asking Microsoft to grant their permissions" IsChecked="{Binding PermissionsApproved, Mode=TwoWay}" Margin="0,16,0,8"><TextBlock Text="I approve creating or repairing these two applications as shown, the engineer assignment shown, and asking Microsoft to grant each one the permissions listed." TextWrapping="Wrap"/></CheckBox>
          <TextBlock Text="Type the tenant ID in full to confirm" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MaxWidth="460" HorizontalAlignment="Left" MinWidth="360" AutomationProperties.Name="Confirm application setup tenant ID"/>
          <Button Content="Create apps and grant permissions" Command="{Binding CreateCommand}" Style="{StaticResource WarningButton}" HorizontalAlignment="Left"/>
          <TextBlock Text="Your browser then opens Microsoft's approval page once for each application: check the list and select Accept each time. The toolkit reads the actual grants afterwards rather than trusting the browser. If anything does not complete, it stops and says why; it never retries a write it could not confirm." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0" AutomationProperties.Name="Application setup results"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Padding="16" Margin="0,0,0,12" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><StackPanel>
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Margin="0,5,0,8" FontFamily="Consolas" FontSize="11"><Run Text="Client ID: "/><Run Text="{Binding ClientId, Mode=OneWay}"/></TextBlock>
              <TextBlock FontWeight="SemiBold"><Run Text="Outcome: "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,5,0,8"><Run Text="Configuration verification: "/><Run Text="{Binding ConfigurationVerification, Mode=OneWay}"/></TextBlock>
              <TextBlock Text="{Binding Reason}" Margin="0,0,0,8"/>
              <Expander Header="Each write outcome" IsExpanded="True"><StackPanel Margin="0,8,0,0">
                <TextBlock><Run Text="New registration creation: "/><Run Text="{Binding ApplicationWrite, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,5,0,0"><Run Text="New enterprise app creation: "/><Run Text="{Binding ServicePrincipalWrite, Mode=OneWay}"/></TextBlock>
                <ItemsControl ItemsSource="{Binding AdditionalWrites}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,5,0,0"><Run Text="{Binding Action, Mode=OneWay}"/>: <Run Text="{Binding Acceptance, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></Expander>
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Content="Check again" Command="{Binding ValidateCommand}" Style="{StaticResource SecondaryButton}" Margin="20,0,0,0"/><TextBlock Text="3  Connect" Style="{StaticResource H2}"/></DockPanel>
          <TextBlock Text="These checks are read from Microsoft Graph: which permissions each application needs, which are granted and whether you are assigned. Connect once the assessment application is ready." Style="{StaticResource Muted}" Margin="0,10,0,16"/>
          <ItemsControl ItemsSource="{Binding Validations}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}" Background="{StaticResource BgPanel}" Padding="16">
              <StackPanel>
                <TextBlock Text="{Binding Mode}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ClientId}" Style="{StaticResource Mono}" Margin="0,4,0,12"/>
                <WrapPanel>
                  <TextBlock Margin="0,0,24,8" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Configuration: needs attention"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding ConfigurationValid}" Value="True"><Setter Property="Text" Value="Configuration: verified"/><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  <TextBlock Margin="0,0,24,8" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Consent: needs attention"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding ConsentComplete}" Value="True"><Setter Property="Text" Value="Consent: verified"/><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  <TextBlock Margin="0,0,0,8" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="Engineer assignment: needs attention"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Style.Triggers><DataTrigger Binding="{Binding EngineerAssignmentConfirmed}" Value="True"><Setter Property="Text" Value="Engineer assignment: verified"/><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </WrapPanel>
                <TextBlock Text="{Binding PermissionSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding MissingScopes}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding EngineerAssignmentStatus}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Danger}" Margin="0,3,0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding AccessStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                <Expander Header="Configured and granted scopes" Margin="0,8,0,0"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Configured" Style="{StaticResource FieldLabel}"/><ItemsControl ItemsSource="{Binding ConfiguredScopes}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Granted" Style="{StaticResource FieldLabel}"/><ItemsControl ItemsSource="{Binding GrantedScopes}"/></StackPanel></Grid></Expander>
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel><Button Content="Connect read-only now" Command="{Binding ContinueAssessmentCommand}"/><Button Content="Continue to deployment" Command="{Binding ContinueDeploymentCommand}" Style="{StaticResource WarningButton}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Existing applications and manual steps" Style="{StaticResource H2}"/>
          <TextBlock Text="Not needed for a new tenant. The client IDs fill in after setup. If the tool applications already exist, enter their client IDs and select Preview again to check or repair them; names alone never establish which applications are the tool's." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Assessment application (client) ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AssessmentClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Assessment application client ID"/><Button Content="Approve assessment permissions" Command="{Binding AssessmentConsentCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Deployment application (client) ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DeploymentClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Deployment application client ID"/><Button Content="Approve deployment permissions" Command="{Binding DeploymentConsentCommand}" Style="{StaticResource WarningButton}" HorizontalAlignment="Left"/></StackPanel></Grid>
          <TextBlock Text="Application name prefix" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" MaxWidth="460" HorizontalAlignment="Left" MinWidth="360" AutomationProperties.Name="Application name prefix"/>
          <TextBlock Text="Partner (GDAP) or group access does not appear as a direct assignment. The delegated-admin check signs in to the tenant and lets Microsoft enforce access; it grants no roles or permissions." Style="{StaticResource Muted}" Margin="0,12,0,8"/>
          <WrapPanel><Button Content="Check delegated-admin deployment access" Command="{Binding CheckDelegatedAdminCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Return to connection details" Command="{Binding ApplyIdsCommand}" Style="{StaticResource QuietButton}"/><Button Content="Open Entra for other engineers or delegated-admin access" Command="{Binding OpenEntraCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoft}"><StackPanel><TextBlock Text="SETUP OUTCOME &amp; NEXT STEPS" Style="{StaticResource Eyebrow}"/><TextBox AutomationProperties.Name="Setup outcome and next steps" Text="{Binding Outcome, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Background="Transparent" Padding="0" Margin="0"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
