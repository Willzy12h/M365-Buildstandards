<UserControl x:Class="BDIT.TenantToolkit.App.Views.ConnectView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="01 / CONNECT TO A CLIENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Start with read-only access" Style="{StaticResource H1}"/>
      <TextBlock Text="Choose a saved client or connect once. Microsoft handles credentials and MFA in a Windows sign-in window. Browser fallback is available below." Style="{StaticResource Lead}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Saved clients" Style="{StaticResource H2}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="New client" Command="{Binding NewProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0" AutomationProperties.Name="Saved client"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Company, Mode=OneWay}"/> · <Run Text="{Binding TenantId, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
          <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Muted}" Margin="0,10,0,12"/>
          <WrapPanel><Button Content="Connect saved client read-only" Command="{Binding ConnectSelectedCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Remove saved client" Command="{Binding DeleteProfileCommand}" Style="{StaticResource QuietButton}" Foreground="{StaticResource Danger}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Connection details" Style="{StaticResource H2}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Client label *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditCompany, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Client label"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Tenant ID *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditTenantId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Tenant ID"/></StackPanel>
          </Grid>
          <TextBlock Text="Primary domain (reference label)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditDomain, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Primary domain"/>
          <Expander Header="Application IDs and setup" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="Assessment has read-only permissions. Deployment has separate write permissions. Setup creates or repairs both and fills these IDs for you." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Assessment application (client) ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditAssessmentClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Assessment client ID"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Deployment application (client) ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditDeploymentClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Deployment client ID"/></StackPanel>
              </Grid>
              <WrapPanel><Button Content="Set up or validate applications" Command="{Binding OpenSetupCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Copy configured application details" Command="{Binding CopyApplicationCommand}" Style="{StaticResource QuietButton}"/></WrapPanel>
              <TextBox Text="{Binding ApplicationText, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="11" Margin="0"/>
            </StackPanel>
          </Expander>
          <Expander Header="Notes and policy parameters" Margin="0,0,0,12">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="Resolve named accounts in the exclusions section below. Existing account IDs can also be retained here." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
              <TextBlock Text="Emergency-access account IDs (comma separated)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditEmergencyIds, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
              <TextBlock Text="Office named location ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditOfficeLocationId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
              <TextBlock Text="Approved MAM-only group ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditMamGroupId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
              <TextBlock Text="Pilot group ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditPilotGroupId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
              <TextBlock Text="Conditional Access exclusion group ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditCaExclusionGroupId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
              <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
            </StackPanel>
          </Expander>
          <CheckBox Content="Use external browser instead of Windows sign-in" IsChecked="{Binding UseSystemBrowser, Mode=TwoWay}"/>
          <CheckBox Content="Remember this connection on this computer" IsChecked="{Binding RememberConnection, Mode=TwoWay}"/>
          <TextBlock Text="Leave unticked for a one-time connection. Captures and run evidence are still retained locally." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
          <WrapPanel><Button Content="Connect read-only" Command="{Binding ConnectAssessmentCommand}"/><Button Content="Save client details" Command="{Binding SaveProfileCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Current connection and access" Style="{StaticResource H2}"/><TextBlock Text="{Binding ConnectionText}" Margin="0,0,0,14"/>
          <WrapPanel><Button Content="Check access" Command="{Binding CheckAccessCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Connect for deployment" Command="{Binding ConnectDeploymentCommand}" Style="{StaticResource WarningButton}"/></WrapPanel>
          <TextBlock Text="Deployment uses a separate write-capable sign-in. Tenant changes still require a reviewed plan, complete before-change evidence and tenant confirmation." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
          <Expander Header="Access check results">
            <StackPanel Margin="0,10,0,0">
              <TextBox Text="{Binding AccessSummary, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}"/><Button Content="Copy access check" Command="{Binding CopyAccessCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
              <TextBlock Text="Observed directory roles" Style="{StaticResource FieldLabel}"/><ItemsControl ItemsSource="{Binding AccessRoles}" Margin="0,0,0,12"/>
              <DataGrid ItemsSource="{Binding AccessReads}" MaxHeight="300" Margin="0,0,0,12"><DataGrid.Columns><DataGridTextColumn Header="Read collection" Binding="{Binding Label}" Width="220"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="260"/><DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
              <DataGrid ItemsSource="{Binding AccessWrites}" MaxHeight="250" Margin="0,0,0,12"><DataGrid.Columns><DataGridTextColumn Header="Write capability" Binding="{Binding Label}" Width="220"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="260"/><DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
              <ItemsControl ItemsSource="{Binding AccessNotes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Conditional Access exclusions" Style="{StaticResource H2}"/>
          <Border Style="{StaticResource WarnPanel}" Padding="14"><TextBlock Text="Exclusions continue to apply when a policy is enabled. Keep emergency-access accounts and approved exceptions deliberate and documented. The delegated creator exclusion is also retained until explicitly removed after testing." Foreground="{StaticResource Warn}"/></Border>
          <TextBlock Text="Search by full sign-in address or display name" Style="{StaticResource FieldLabel}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Find account" Command="{Binding SearchAccountsCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,12"/><TextBox Text="{Binding AccountQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Account search"/></DockPanel>
          <TextBlock Text="{Binding LookupStatus}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <DataGrid ItemsSource="{Binding AccountMatches}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" MaxHeight="240" Margin="0,0,0,16" AutomationProperties.Name="Resolved account matches"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Sign-in address" Binding="{Binding UserPrincipalName}" Width="*"/><DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="300"/></DataGrid.Columns></DataGrid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Purpose" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ExclusionPurposes}" SelectedItem="{Binding ExclusionPurpose, Mode=TwoWay}" AutomationProperties.Name="Exclusion purpose"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reason for exclusion" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ExclusionReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Exclusion reason"/></StackPanel></Grid>
          <Button Content="Add selected account" Command="{Binding AddExclusionCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
          <TextBlock Text="Selected exclusions" Style="{StaticResource FieldLabel}" Margin="0,12,0,8"/>
          <DataGrid ItemsSource="{Binding ExclusionAccounts}" SelectedItem="{Binding SelectedExclusion, Mode=TwoWay}" MaxHeight="260" Margin="0,0,0,12" AutomationProperties.Name="Selected exclusions"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="180"/><DataGridTextColumn Header="Sign-in address" Binding="{Binding UserPrincipalName}" Width="220"/><DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="150"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="300"/></DataGrid.Columns></DataGrid>
          <WrapPanel><Button Content="Apply exclusions to connection" Command="{Binding ApplyExclusionsCommand}"/><Button Content="Remove selected exclusion" Command="{Binding RemoveExclusionCommand}" Style="{StaticResource QuietButton}" Foreground="{StaticResource Danger}"/></WrapPanel>
          <TextBlock Text="Applying a changed selection invalidates the current plan. Capture and review again before deployment." Style="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
