<UserControl x:Class="BDIT.TenantToolkit.App.Views.StandardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BDIT.TenantToolkit.App.Views"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <!-- The page fills the window down to a minimum height, then scrolls: a short window (a laptop at 150% scaling)
       would otherwise squeeze the tables and guidance below it out of reach. See PageLayout.MinimumHeight. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="STANDARD &amp; REFERENCE" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="M365 Build Standard" Style="{StaticResource H1}"/>
          <TextBlock Style="{StaticResource Lead}" Text="Review each control, its expected production state and candidate creation recipe. Manual controls remain visible alongside automation."/>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="{Binding HeaderText}"/>
              <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="Release" VerticalAlignment="Center" Margin="0,0,6,10"/>
                <ComboBox AutomationProperties.Name="Build Standard release" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}" DisplayMemberPath="Release" Width="180" Margin="0,0,12,10"/>
                <Button Content="Use this release" Command="{Binding SelectReleaseCommand}" Style="{StaticResource SecondaryButton}"/>
                <TextBlock Text="Category" VerticalAlignment="Center" Margin="12,0,6,10"/>
                <ComboBox AutomationProperties.Name="Control category" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Width="180" Margin="0,0,12,10"/>
                <StackPanel><TextBlock Text="Search controls" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Search standard controls"/></StackPanel>
              </WrapPanel>
              <Expander Header="Export a client build standard document" IsExpanded="False" Margin="0,8,0,0">
               <StackPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Export the proposed standard, intended scope and required client decisions. This catalogue document does not prove deployment or tenant compliance; use the assessment and deployment evidence for observed results."/>
              <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="Prepared for" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,0" AutomationProperties.Name="Client name for the build standard document"/>
                <Button Content="Export document (HTML)" Command="{Binding ExportDocumentCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Export document (Markdown)" Command="{Binding ExportDocumentMarkdownCommand}" Style="{StaticResource SecondaryButton}"/>
              </WrapPanel>
              <TextBlock Text="{Binding LastExport}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
               </StackPanel>
              </Expander>
              <Expander Header="Export engineer standards and manual guide" IsExpanded="False" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="{Binding EngineerDocumentHint}" Style="{StaticResource Muted}"/>
                  <TextBlock Text="The Build Standard - settings, purpose, scope and licences" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                  <WrapPanel>
                    <Button Content="Standard (HTML)" Command="{Binding ExportEngineerHtmlCommand}" AutomationProperties.Name="Export engineer build standard as HTML" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Standard (Markdown)" Command="{Binding ExportEngineerMarkdownCommand}" AutomationProperties.Name="Export engineer build standard as Markdown" Style="{StaticResource SecondaryButton}"/>
                  </WrapPanel>
                  <TextBlock Text="Manual guide - before, by hand and after checks" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                  <WrapPanel>
                    <Button Content="Manual guide (HTML)" Command="{Binding ExportManualHtmlCommand}" AutomationProperties.Name="Export manual implementation guide as HTML" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Manual guide (Markdown)" Command="{Binding ExportManualMarkdownCommand}" AutomationProperties.Name="Export manual implementation guide as Markdown" Style="{StaticResource SecondaryButton}"/>
                  </WrapPanel>
                  <TextBox Text="{Binding LastExport, Mode=OneWay}" AutomationProperties.Name="Exported engineer document path" Style="{StaticResource ReadOnlyDetail}"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>
          <ListBox Grid.Column="0" AutomationProperties.Name="Standard controls" ItemsSource="{Binding Controls}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,20,0" BorderBrush="{StaticResource Line}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Id, Mode=OneWay}"/> <Run Text="{Binding Name, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding Category, Mode=OneWay}"/> · <Run Text="{Binding Severity, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Selected standard detail"><StackPanel>
            <views:PrerequisitePanel Items="{Binding Selected.Prerequisites}"/>
            <TextBox AutomationProperties.Name="Selected control detail" Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BgPanel}" Padding="12"/>
            <TextBlock Text="Recipe template" Style="{StaticResource Muted}" Margin="0,8,0,4"/>
            <TextBox AutomationProperties.Name="Control payload" Text="{Binding PayloadJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="100" MaxHeight="360" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
