<UserControl x:Class="BDIT.TenantToolkit.App.Views.StandardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="STANDARD &amp; REFERENCE" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="M365 Build Standard" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Lead}" Text="Review each control, its expected production state and candidate creation recipe. Manual controls remain visible alongside automation."/>
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="{Binding HeaderText}"/>
          <WrapPanel Margin="0,10,0,0">
            <TextBlock Text="Release" VerticalAlignment="Center" Margin="0,0,6,10"/>
            <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}" DisplayMemberPath="Release" Width="180" Margin="0,0,12,10"/>
            <Button Content="Use this release" Command="{Binding SelectReleaseCommand}" Style="{StaticResource SecondaryButton}"/>
            <TextBlock Text="Category" VerticalAlignment="Center" Margin="12,0,6,10"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Width="180" Margin="0,0,12,10"/>
            <StackPanel><TextBlock Text="Search controls" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Search standard controls"/></StackPanel>
          </WrapPanel>
          <TextBlock Text="Client build standard document" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Writes the client-facing description of this release: what each control protects, what it means in practice, and what the client still has to supply. Generated from the loaded standard, so it cannot describe a setting the toolkit would not apply."/>
          <WrapPanel Margin="0,6,0,0">
            <TextBlock Text="Prepared for" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,12,0" AutomationProperties.Name="Client name for the build standard document"/>
            <Button Content="Export document (HTML)" Command="{Binding ExportDocumentCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Export document (Markdown)" Command="{Binding ExportDocumentMarkdownCommand}" Style="{StaticResource SecondaryButton}"/>
          </WrapPanel>
          <TextBlock Text="{Binding LastExport}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <ListBox Grid.Column="0" ItemsSource="{Binding Controls}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,20,0" BorderBrush="{StaticResource Line}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{Binding Id, Mode=OneWay}"/> <Run Text="{Binding Name, Mode=OneWay}"/>
              </TextBlock>
              <TextBlock Style="{StaticResource Muted}">
                <Run Text="{Binding Category, Mode=OneWay}"/> · <Run Text="{Binding Severity, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Column="1">
        <TextBox DockPanel.Dock="Top" Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BgPanel}" Padding="12" MaxHeight="360" VerticalScrollBarVisibility="Auto"/>
        <TextBlock DockPanel.Dock="Top" Text="Recipe template" Style="{StaticResource Muted}" Margin="0,8,0,4"/>
        <TextBox Text="{Binding PayloadJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
