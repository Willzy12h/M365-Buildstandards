<UserControl x:Class="BDIT.TenantToolkit.App.Views.DeviationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="04 / RECORD AGREED EXCEPTIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Deviation register" Style="{StaticResource H1}"/><TextBlock Text="Record an approved departure, its owner and review date. Failed reads and unknown data remain visible in the assessment." Style="{StaticResource Lead}"/></StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16"><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/></Border>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Recorded deviations">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="100"/>
            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="180"/>
            <DataGridTextColumn Header="Approved by" Binding="{Binding ApprovedBy}" Width="140"/>
            <DataGridTextColumn Header="Review by" Binding="{Binding ReviewBy}" Width="110"/>
            <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAt}" Width="160"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="DEVIATION DETAILS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Record or update" Style="{StaticResource H2}"/>
            <TextBlock Text="Required fields are marked *." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="Control *" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding ControlIds}" SelectedItem="{Binding ControlId, Mode=TwoWay}" IsEditable="True" Text="{Binding ControlId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Control"/>
            <TextBlock Text="Kind *" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=TwoWay}" AutomationProperties.Name="Deviation kind"/>
            <TextBlock Text="Reason *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Reason for deviation"/>
            <TextBlock Text="Approved alternative state" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ApprovedState, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Approved alternative state"/>
            <TextBlock Text="Owner / client contact" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner"/>
            <TextBlock Text="Approved by *" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ApprovedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Approved by"/>
            <TextBlock Text="Review by (yyyy-MM-dd)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReviewBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Review date"/>
            <TextBlock Text="Reference / ticket" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reference"/>
            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" AutomationProperties.Name="Notes"/>
            <WrapPanel><Button Content="Save deviation" Command="{Binding SaveCommand}"/><Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Remove" Command="{Binding DeleteCommand}" Style="{StaticResource QuietButton}" Foreground="{StaticResource Danger}"/></WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
