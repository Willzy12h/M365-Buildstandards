<UserControl x:Class="BDIT.TenantToolkit.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <!-- The page fills the window down to a minimum height, then scrolls: a short window (a laptop at 150% scaling)
       would otherwise squeeze the tables and guidance below it out of reach. See PageLayout.MinimumHeight. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="EVIDENCE &amp; HANDOVER" Style="{StaticResource Eyebrow}"/><TextBlock Text="Jobs and completion" Style="{StaticResource H1}"/><TextBlock Text="{Binding ContextText}" Style="{StaticResource Lead}"/></StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="{Binding ClaimText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="A complete job is a record of review. It grants no permission to change the tenant." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource WarnPanel}" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding ProblemsText}" TextWrapping="Wrap"/>
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}" Height="150" Margin="0,0,0,12" AutomationProperties.Name="Jobs">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Opened" Binding="{Binding Opened}" Width="170"/>
                <DataGridTextColumn Header="Intention" Binding="{Binding Intention}" Width="120"/>
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                <DataGridTextColumn Header="Completion" Binding="{Binding Claim}" Width="*" MinWidth="220"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Requirements}" SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}" AutomationProperties.Name="Requirements in the selected job">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Requirement" Binding="{Binding InstanceKey}" Width="130"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                <DataGridTemplateColumn Header="State" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding State, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding State, Converter={StaticResource Words}}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100"/>
                <DataGridTextColumn Header="Decision" Binding="{Binding Decision, Converter={StaticResource Words}}" Width="170"/>
                <DataGridTextColumn Header="Cutover" Binding="{Binding Cutover}" Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="SELECTED REQUIREMENT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding RequirementText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="RECORD FOR THIS REQUIREMENT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding CaptureText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Record *" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding RecordKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding RecordKind, Mode=TwoWay}" AutomationProperties.Name="What to record"/>
                <StackPanel Visibility="{Binding IsOutcome, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Outcome *" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status, Mode=TwoWay}" AutomationProperties.Name="Outcome"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsDecision, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Decision *" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Decisions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Decision, Mode=TwoWay}" AutomationProperties.Name="Decision"/>
                  <TextBlock Text="Decision owner *" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding DecisionOwner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Decision owner"/>
                  <StackPanel Visibility="{Binding IsDeparture, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Approved deviation *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DeviationIds}" IsEditable="True" Text="{Binding DeviationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Approved deviation"/>
                    <TextBlock Text="An approved departure relies on an existing, in-date approved deviation for this control. It never creates one." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Reason"/>
                <TextBlock Text="Object IDs (one per line)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ObjectIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Object IDs"/>
                <TextBlock Text="Review by (yyyy-MM-dd) *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ReviewDue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Review by"/>
                <Button Content="Record" Command="{Binding RecordCommand}" HorizontalAlignment="Left"/>

                <TextBlock Text="OPEN A JOB" Style="{StaticResource Eyebrow}" Margin="0,20,0,0"/>
                <TextBlock Text="A job binds the loaded standard and this client's inputs. Changing either later sends it to review." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="Intention *" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Intentions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding NewIntention, Mode=TwoWay}" AutomationProperties.Name="Job intention"/>
                <TextBlock Text="Owner *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NewOwner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Job owner"/>
                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Job notes"/>
                <Button Content="Open job" Command="{Binding OpenJobCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
