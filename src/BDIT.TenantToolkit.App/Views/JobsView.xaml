<UserControl x:Class="BDIT.TenantToolkit.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BDIT.TenantToolkit.App.Infrastructure">
  <!-- The page fills the window down to a minimum height, then scrolls: a short window (a laptop at 150% scaling)
       would otherwise squeeze the tables and guidance below it out of reach. See PageLayout.MinimumHeight. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="EVIDENCE &amp; HANDOVER" Style="{StaticResource Eyebrow}"/><TextBlock Text="Jobs and completion" Style="{StaticResource H1}"/><TextBlock Text="{Binding ContextText}" Style="{StaticResource Lead}"/></StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="{Binding ClaimText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="A complete job is a record of review. It grants no permission to change the tenant." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource WarnPanel}" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding ProblemsText}" TextWrapping="Wrap"/>
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}" Height="150" Margin="0,0,0,12" AutomationProperties.Name="Jobs">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Opened" Binding="{Binding Opened}" Width="170"/>
                <DataGridTextColumn Header="Intention" Binding="{Binding Intention}" Width="120"/>
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                <DataGridTextColumn Header="Completion" Binding="{Binding Claim}" Width="*" MinWidth="220"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Requirements}" SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}" AutomationProperties.Name="Requirements in the selected job">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Requirement" Binding="{Binding Name}" Width="*" MinWidth="220"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding InstanceKey}" Width="130"/>
                <DataGridTemplateColumn Header="State" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding State, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding State, Converter={StaticResource Words}}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100"/>
                <DataGridTextColumn Header="Decision" Binding="{Binding Decision, Converter={StaticResource Words}}" Width="170"/>
                <DataGridTextColumn Header="Cutover" Binding="{Binding Cutover}" Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="SELECTED REQUIREMENT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding RequirementText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button Content="Copy requirement details" Command="{Binding CopyRequirementCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <TextBlock Text="RECORD FOR THIS REQUIREMENT" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding RecordGuidance}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CaptureText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Record *" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding RecordKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding RecordKind, Mode=TwoWay}" AutomationProperties.Name="What to record"/>
                <StackPanel Visibility="{Binding IsOutcome, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Outcome *" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status, Mode=TwoWay}" AutomationProperties.Name="Outcome"/>
                  <TextBlock Text="Stored assessment cited as evidence" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Assessments}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding AssessmentId, Mode=TwoWay}" AutomationProperties.Name="Cited assessment"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsDecision, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Decision *" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Decisions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Decision, Mode=TwoWay}" AutomationProperties.Name="Decision"/>
                  <StackPanel Visibility="{Binding IsDeparture, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Approved deviation *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DeviationIds}" IsEditable="True" Text="{Binding DeviationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Approved deviation"/>
                    <TextBlock Text="An approved departure relies on an existing, in-date approved deviation for this control. It never creates one." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding IsCutover, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Case *" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding CutoverCases}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedCase, Mode=TwoWay}" AutomationProperties.Name="Cutover case"/>
                  <TextBlock Text="Stage *" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Stages}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Stage, Mode=TwoWay}" AutomationProperties.Name="Cutover stage"/>
                  <TextBlock Text="Replacement moves one stage at a time. Record the separate approval and evidence from the actual work; this form does not activate, assign or retire protection." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasOwner, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Owner *" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding DecisionOwner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner"/>
                </StackPanel>
                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Reason"/>
                <TextBlock Text="{Binding ObjectsLabel}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ObjectIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Object IDs"/>
                <StackPanel Visibility="{Binding IsCutover, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Overlaps with the old protection" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding Overlaps, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Overlaps"/>
                  <TextBlock Text="Recovery limits" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding RecoveryLimits, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Recovery limits"/>
                  <TextBlock Text="New object IDs (one per line)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding NewObjectIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="New object IDs"/>
                  <TextBlock Text="Run that created and read back the new objects" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Runs}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding RunId, Mode=TwoWay}" AutomationProperties.Name="Candidate run"/>
                  <TextBlock Text="Pilot group IDs (one per line)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding PilotGroupIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Pilot group IDs"/>
                  <TextBlock Text="Pilot approved by" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding PilotApprovedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pilot approved by"/>
                  <TextBlock Text="Pilot approval reference" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding PilotReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pilot approval reference"/>
                  <TextBlock Text="Prerequisites (one per line, [x] when met)" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="The engineer checks these dependencies. Start each confirmed item with [x]; an unticked item remains outstanding." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                  <TextBox Text="{Binding Prerequisites, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Prerequisites"/>
                  <TextBlock Text="Criteria (result | description | what was observed)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding Criteria, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Functional criteria"/>
                  <TextBlock Text="Results are Passed, Failed or NotRun. Record what was actually observed, and where." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                  <TextBlock Text="Retirement" Style="{StaticResource FieldLabel}"/>
                  <ComboBox ItemsSource="{Binding Retirements}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Retirement, Mode=TwoWay}" AutomationProperties.Name="Retirement decision"/>
                  <TextBlock Text="Retirement approved by" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding RetirementApprovedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retirement approved by"/>
                  <TextBlock Text="Retirement approval reference" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding RetirementReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retirement approval reference"/>
                  <TextBlock Text="Residual approved deviations (IDs, one per line)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding ResidualDeviationIds, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas" AutomationProperties.Name="Residual deviations"/>
                  <TextBlock Text="Unsupported scenario (stops the case)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding EscalationReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Unsupported scenario"/>
                  <TextBlock Text="Escalation owner" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding EscalationOwner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escalation owner"/>
                  <TextBlock Text="Escalation path" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding EscalationPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escalation path"/>
                </StackPanel>
                <TextBlock Text="Review by (yyyy-MM-dd) *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ReviewDue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Review by"/>
                <Button Content="Record" Command="{Binding RecordCommand}" HorizontalAlignment="Left" ToolTip="{Binding RecordGuidance}" ToolTipService.ShowOnDisabled="True"/>

                <TextBlock Text="OPEN A JOB" Style="{StaticResource Eyebrow}" Margin="0,20,0,0"/>
                <TextBlock Text="{Binding OpenJobGuidance}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="A job binds the loaded standard and this client's inputs. Changing either later sends it to review." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Text="Intention *" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Intentions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding NewIntention, Mode=TwoWay}" AutomationProperties.Name="Job intention"/>
                <TextBlock Text="Owner *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NewOwner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Job owner"/>
                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Job notes"/>
                <Button Content="Open job" Command="{Binding OpenJobCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" ToolTip="{Binding OpenJobGuidance}" ToolTipService.ShowOnDisabled="True"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
