<Window x:Class="BDIT.TenantToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BDIT.TenantToolkit.App.ViewModels"
        xmlns:views="clr-namespace:BDIT.TenantToolkit.App.Views"
        Title="{Binding WindowTitle}" Height="940" Width="1480" MinHeight="760" MinWidth="1180"
        Background="{StaticResource BgWindow}" WindowStartupLocation="CenterScreen" Icon="Assets/buildstandard.png"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closing="OnClosing">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecoveryViewModel}"><views:RecoveryView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConnectViewModel}"><views:ConnectView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ApplicationSetupViewModel}"><views:ApplicationSetupView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}"><views:ConfigurationView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AssessmentViewModel}"><views:AssessmentView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeviationsViewModel}"><views:DeviationsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlanViewModel}"><views:PlanView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeployViewModel}"><views:DeployView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ManualChecksViewModel}"><views:ManualChecksView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StandardViewModel}"><views:StandardView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource BgWindow}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Background="{StaticResource BgNav}">
      <Border DockPanel.Dock="Top" Padding="22,26,18,24">
        <StackPanel>
          <Image Source="Assets/buildstandard.png" Width="38" Height="38" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <TextBlock Text="{Binding ProductName}" Foreground="White" FontWeight="SemiBold" FontSize="17" LineHeight="23"/>
          <TextBlock Text="ENGINEER WORKSPACE" Foreground="#A9C4DC" FontSize="10" Margin="0,7,0,0"/>
        </StackPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Padding="18,16" Background="{StaticResource BgNavHeader}">
        <StackPanel>
          <TextBlock Text="{Binding StandardText}" Foreground="{StaticResource TextNav}" FontSize="11"/>
          <TextBlock Text="{Binding VersionText}" Foreground="#9DB5CA" FontSize="10" Margin="0,7,0,0" MaxHeight="66" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionText}"/>
        </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="WORKFLOW" Foreground="#94B2CD" FontSize="10" FontWeight="SemiBold" Margin="22,0,0,10"/>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,0,10,20">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel>
                <TextBlock Text="EVIDENCE &amp; REFERENCE" Foreground="#94B2CD" FontSize="10" FontWeight="SemiBold" Margin="12,22,0,10">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Key}" Value="history"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                </TextBlock>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="12,11" Margin="0,0,0,4" BorderThickness="1">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter Property="Background" Value="#204866"/><Setter Property="BorderBrush" Value="#3B6485"/>
                    </DataTrigger></Style.Triggers>
                  </Style></Button.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Step}" Foreground="#9DCEF2" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextNav}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
    <DockPanel Grid.Column="1">
      <!-- Identity stays visible while navigating, including during a write-capable session. -->
      <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="CURRENT TENANT" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="{Binding TenantTitle}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding TenantTitle}"/>
            <TextBlock Text="{Binding TenantSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <TextBlock Text="SIGNED-IN IDENTITY" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="{Binding HeaderAccount}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock Text="{Binding HeaderTenantId}" Style="{StaticResource Mono}" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="240">
            <Border CornerRadius="5" Padding="10,7">
              <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource BgPanel}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAssessmentSession}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsDeploymentSession}" Value="True"><Setter Property="Background" Value="{StaticResource WarnBg}"/></DataTrigger>
                </Style.Triggers>
              </Style></Border.Style>
              <TextBlock Text="{Binding ModeBadge}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAssessmentSession}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsDeploymentSession}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                  </Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
            </Border>
            <Button Content="Disconnect tenant" Command="{Binding DisconnectCommand}" Style="{StaticResource QuietButton}" Margin="0,5,0,0" Visibility="{Binding HeaderHasConnection, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Expander DockPanel.Dock="Top" Header="Connection details" Background="White" Padding="28,3" Visibility="{Binding HeaderHasConnection, Converter={StaticResource BoolToVis}}">
        <DockPanel Margin="0,8,0,6">
          <Button DockPanel.Dock="Right" Content="Copy details" Command="{Binding CopyDetailsCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"/>
          <TextBox Text="{Binding DetailsText, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="11" MaxHeight="180" Margin="0,0,12,0"/>
        </DockPanel>
      </Expander>
      <Border DockPanel.Dock="Top" Background="{StaticResource DangerBg}" BorderBrush="#EDBEC1" BorderThickness="0,0,0,1" Padding="28,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding ClearErrorCommand}" Style="{StaticResource QuietButton}" Margin="16,0,0,0"/>
          <StackPanel><TextBlock Text="Action needs attention" Foreground="{StaticResource Danger}" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" Padding="28,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel operation" Command="{Binding CancelOperationCommand}" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"/>
          <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="88" Height="5" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <StackPanel><TextBlock Text="{Binding BusyMessage}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
      </Border>
      <Expander DockPanel.Dock="Bottom" Header="Activity log" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,8" IsExpanded="False">
        <ListBox ItemsSource="{Binding Activity}" Height="160" FontFamily="Consolas" FontSize="11" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"><Run Text="{Binding At, Mode=OneWay}"/>  <Run Text="{Binding Level, Mode=OneWay}"/>  <Run Text="{Binding Category, Mode=OneWay}"/>: <Run Text="{Binding Message, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Expander>
      <ContentControl Content="{Binding CurrentPage}"/>
    </DockPanel>
  </Grid>
</Window>
