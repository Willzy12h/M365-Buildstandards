<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The portable app hosts this DLL; developer dotnet bdit.dll remains supported. -->
    <UseAppHost>false</UseAppHost>
    <!-- SelfContained flows from the WPF publish. Compile the same public Program.Main as its
         managed library dependency; standalone developer builds keep the normal DLL entry point. -->
    <OutputType Condition="'$(SelfContained)' == 'true'">Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bdit</AssemblyName>
    <RootNamespace>BDIT.TenantToolkit.Cli</RootNamespace>
    <Description>Headless, offline reporting over the toolkit engine. Reads captured evidence; never connects to a tenant.</Description>
    <!-- The engine depends on the Graph project, which protects its token cache with Windows DPAPI. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BDIT.TenantToolkit.Engine\BDIT.TenantToolkit.Engine.csproj" />
  </ItemGroup>
  <!-- A referenced project is built, never published, inside the App's self-contained publish, so this target runs
       only when this project itself is published self-contained. That would otherwise silently produce a library
       with no entry point or host. The portable CLI ships only through the App (INT-074/INT-079). -->
  <Target Name="RefuseStandaloneSelfContainedPublish" BeforeTargets="PrepareForPublish" Condition="'$(SelfContained)' == 'true'">
    <Error Text="bdit cannot be published self-contained on its own: it would be a library with no entry point. Publish BDIT.TenantToolkit.App, which hosts it through bdit.cmd, or publish this project framework-dependent for dotnet bdit.dll." />
  </Target>
</Project>
