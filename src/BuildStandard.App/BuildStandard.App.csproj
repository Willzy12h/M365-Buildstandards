<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BuildStandard.App</AssemblyName>
    <RootNamespace>BuildStandard.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\BuildStandard.Graph\Assets\buildstandard.ico</ApplicationIcon>
    <Description>BuildStandard desktop application.</Description>
    <!-- Published as a self-contained win-x64 folder by build/Build-Portable.ps1; trimming and single-file are not used because WPF does not support them safely. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>BuildStandard.App.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\BuildStandard.Graph\Assets\buildstandard.png" Link="Assets\buildstandard.png" />
    <ProjectReference Include="..\BuildStandard.Core\BuildStandard.Core.csproj" />
    <ProjectReference Include="..\BuildStandard.Graph\BuildStandard.Graph.csproj" />
    <ProjectReference Include="..\BuildStandard.Engine\BuildStandard.Engine.csproj" />
    <ProjectReference Include="..\BuildStandard.Cli\BuildStandard.Cli.csproj" />
  </ItemGroup>
  <Target Name="VerifyPublishedTextEditingDependency" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <Error Condition="!Exists('$(PublishDir)Accessibility.dll')" Text="The portable publish is incomplete: Accessibility.dll is required by WPF text-box context menus." />
  </Target>
</Project>
