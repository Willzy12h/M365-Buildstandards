<UserControl x:Class="BuildStandard.App.Views.LifecycleView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="EXPERIMENTAL · EXISTING CLOUD-MANAGED MEMBERS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Existing-user actions" Style="{StaticResource H1}"/><TextBlock Text="One exact action, fresh before-evidence and one approval. Account creation, passwords, Exchange, preservation and device work remain separate." Style="{StaticResource Lead}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource WarnPanel}" Padding="12" Margin="0,0,0,12"><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" AutomationProperties.Name="Recorded lifecycle outcome and limitations"/></Border>
  <TabControl Grid.Row="2">
   <TabItem Header="Select and check"><ScrollViewer IsEnabled="{Binding Workspace.Idle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
    <TextBlock Text="Workflow guidance" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Journeys}" SelectedItem="{Binding SelectedJourney}" AutomationProperties.Name="Existing-user workflow guidance"/>
    <TextBlock Text="{Binding ManualSteps}" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <TextBlock Text="Choose one registered action" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ActionChoices}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding SelectedActionId}" AutomationProperties.Name="One registered lifecycle action"/>
    <TextBlock Text="Existing user · captured name and exact ID" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Users}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedUserChoice}" AutomationProperties.Name="Captured lifecycle target user"/>
    <TextBox Text="{Binding SelectedUserId, UpdateSourceTrigger=PropertyChanged}" MaxLength="36" Margin="0,4,0,8" AutomationProperties.Name="Exact lifecycle target user ID" ToolTip="Use the exact user object GUID if it is absent from the captured choices. Names never establish identity or authority."/>
    <StackPanel Visibility="{Binding NeedsGroup, Converter={StaticResource BoolToVis}}"><TextBlock Text="Direct group membership · existing cloud group" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGroupChoice}" AutomationProperties.Name="Captured lifecycle target group"/><TextBox Text="{Binding SelectedGroupId, UpdateSourceTrigger=PropertyChanged}" MaxLength="36" AutomationProperties.Name="Exact lifecycle target group ID" Margin="0,4,0,8"/></StackPanel>
    <StackPanel Visibility="{Binding NeedsSku, Converter={StaticResource BoolToVis}}"><TextBlock Text="One direct licence SKU" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Skus}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSkuChoice}" AutomationProperties.Name="Captured lifecycle licence SKU"/><TextBox Text="{Binding SelectedSkuId, UpdateSourceTrigger=PropertyChanged}" MaxLength="36" AutomationProperties.Name="Exact lifecycle licence SKU ID" Margin="0,4,0,8"/></StackPanel>
    <StackPanel Visibility="{Binding CanDisablePlans, Converter={StaticResource BoolToVis}}">
     <TextBlock Text="Optional service plans to disable · choices come from the captured SKU" Style="{StaticResource FieldLabel}"/>
     <ItemsControl ItemsSource="{Binding ServicePlans}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Disabled}" Content="{Binding Label}" Margin="0,3,0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Expander Header="Exact service-plan IDs when absent from the captured choices" Margin="0,6,0,8"><StackPanel><TextBlock Text="Comma-separated GUIDs. Fresh licence evidence must identify every plan. Newly disabling an existing service requires preservation/retention and business-owner review." TextWrapping="Wrap"/><TextBox Text="{Binding DisabledPlansText, UpdateSourceTrigger=PropertyChanged}" MaxLength="40000" TextWrapping="Wrap" MinHeight="45" AutomationProperties.Name="Additional exact service plan IDs to disable"/></StackPanel></Expander>
    </StackPanel>
    <TextBlock Text="{Binding ReadGuidance}" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <WrapPanel><Button Content="Check target readiness (read-only)" Command="{Binding ReadinessCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ReadGuidance}"/><Button Content="Review access" Command="{Binding AccessCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Capture full configuration" Command="{Binding CaptureCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Connect to this client and wait for the active operation. This is a read-only full capture, separate from lifecycle target reads."/></WrapPanel>
    <TextBlock Text="{Binding ReadinessGuidance}" TextWrapping="Wrap" Margin="0,10,0,8"/>
    <DataGrid ItemsSource="{Binding ReadinessRows}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" MinHeight="115" Height="230" AutomationProperties.Name="Required lifecycle source status and admitted rows"><DataGrid.Columns><DataGridTextColumn Header="Required source" Binding="{Binding Source}" Width="235"/><DataGridTextColumn Header="Read status" Binding="{Binding Status}" Width="115"/><DataGridTextColumn Header="Rows admitted" Binding="{Binding RowsAdmitted}" Width="115"/><DataGridTextColumn Header="Access" Binding="{Binding Scope}" Width="240"/><DataGridTextColumn Header="Detail and next step" Binding="{Binding Detail}" Width="460"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="{Binding PreviewGuidance}" TextWrapping="Wrap" Margin="0,12,0,4"/><Button Content="Prepare one exact preview (no write)" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding PreviewGuidance}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Exact review"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
    <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="Captured before-values and entitlement effects" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BeforeDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="260" AutomationProperties.Name="Captured lifecycle before-values and entitlement effects" Margin="0,0,0,12"/>
    <TextBlock Text="Exact registered request" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ExactRequest, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="160" AutomationProperties.Name="Exact lifecycle method path and proposed values"/>
    <TextBlock Text="Original source and approval identity" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/><TextBox Text="{Binding PreviewIdentity, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="190" AutomationProperties.Name="Lifecycle tenant operator registration plan digest and expiry"/>
    <TextBlock Text="{Binding ApplyGuidance}" TextWrapping="Wrap" Margin="0,12,0,8"/>
    <Button Content="Review exact action…" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ApplyGuidance}"/>
    <TextBlock Text="Experimental changes default off. Stop can prevent dispatch; once a request may have left, wait for its recorded outcome. No retry, replay, automatic next action or remote undo is offered." TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="History and handover"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Historical records never become live approval. A recorded effect does not mean every joiner/mover/leaver task is complete." TextWrapping="Wrap"/><Button Content="Load local attempt history" Command="{Binding HistoryCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,8" ToolTipService.ShowOnDisabled="True" ToolTip="Select a client and wait for the active operation. Reads local stored records only; no sign-in or tenant request."/><TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="110" AutomationProperties.Name="Immutable lifecycle attempts including unknown outcomes"><DataGrid.Columns><DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="190"/><DataGridTextColumn Header="Registered action" Binding="{Binding ActionId}" Width="170"/><DataGridTextColumn Header="Original acceptance" Binding="{Binding WriteAcceptance}" Width="145"/><DataGridTextColumn Header="Original readback" Binding="{Binding Verification}" Width="135"/><DataGridTextColumn Header="Recorded status" Binding="{Binding Status}" Width="155"/><DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedAt}" Width="190"/><DataGridTextColumn Header="Exact record ID" Binding="{Binding Id}" Width="285"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel><Button Content="Re-read selected effect (read-only)" Command="{Binding ReconcileCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Select a saved attempt and connect to its client with the required read access and original catalogue. No write is repeated; unknown acceptance remains blocking."/><ComboBox ItemsSource="{Binding RecordFamilies}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedRecordFamily}" MinWidth="105" AutomationProperties.Name="Historical lifecycle record family to export"/><Button Content="Original JSON" Command="{Binding JsonCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Select an attempt. Missing records are refused, not fabricated."/><Button Content="HTML" Command="{Binding HtmlCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Select an attempt to export inert historical evidence, with no approval authority."/><Button Content="Export latest readback receipt" Command="{Binding ReceiptCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available after an explicit read-only reconciliation in this context."/></WrapPanel><TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Lifecycle evidence export path"/></StackPanel>
   </Grid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
