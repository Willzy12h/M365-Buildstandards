<UserControl x:Class="BuildStandard.App.Views.PinnedReferenceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.Name="Original saved reference">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="16">
   <TextBlock Text="{Binding PinnedReference.Title}" Style="{StaticResource H2}"/>
   <TextBlock Text="{Binding PinnedReference.Provenance}" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
   <Border Background="{StaticResource WarnBg}" Padding="10" Margin="0,0,0,12"><TextBlock Text="{Binding PinnedReference.MismatchText}" Foreground="{StaticResource Warn}"/></Border>
   <TextBlock Text="{Binding PinnedReference.Summary}" Margin="0,0,0,12"/>
   <Expander Header="Original identifiers and capturer" IsExpanded="{Binding PinnedReference.DetailsExpanded}" AutomationProperties.Name="Original saved-reference details">
    <TextBox Text="{Binding PinnedReference.OriginalDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" AutomationProperties.Name="Original saved-reference provenance" Margin="0,8,0,8"/>
   </Expander>
   <Button Content="Copy original reference" Command="{Binding CopyPinnedReferenceCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.HelpText="Copies original provenance only; does not select this record for the working client." Margin="0,12,0,0"/>
   <Button Content="Close reference" Command="{Binding ClosePinnedReferenceCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
