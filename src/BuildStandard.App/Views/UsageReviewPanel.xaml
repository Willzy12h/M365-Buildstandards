<UserControl x:Class="BuildStandard.App.Views.UsageReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TabControl Margin="4">
    <TabItem Header="Read usage">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
          <TextBlock Text="Usage review · experimental and read-only" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding AccessPreview}" TextWrapping="Wrap" Margin="0,4,0,8"/>
          <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
          <TextBlock Text="Choose sources" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding Sources}" IsEnabled="{Binding CanEdit}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,4,18,4" AutomationProperties.Name="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,6,0,6">
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Requested period"/><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" IsEnabled="{Binding CanEdit}" Width="150" AutomationProperties.Name="Usage report requested period"/></StackPanel>
            <Button Content="Connection and access" Command="{Binding OpenConnectionCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" ToolTipService.ShowOnDisabled="True" ToolTip="Open Connect when idle. This navigation does not sign in or request consent."/>
          </WrapPanel>
          <CheckBox IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,6" AutomationProperties.Name="Acknowledge exact experimental usage read"><TextBlock Text="I acknowledge these selected sources, period, read access and privacy limits. This grants no consent or licence-change approval." TextWrapping="Wrap"/></CheckBox>
          <WrapPanel>
            <Button Content="Read selected usage" Command="{Binding ReadCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ReadGuidance}"/>
            <Button Content="Stop usage read" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available only while this page owns an active usage read. Earlier completed source evidence can be retained."/>
          </WrapPanel>
          <TextBlock Text="{Binding ReadGuidance}" TextWrapping="Wrap" Margin="0,6,0,10"/>
          <Button Content="Open saved or supplied usage JSON" Command="{Binding OpenCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="Select a client and resolve a pending original first. Opens bounded40MiB usage packs only; no sign-in or evidence-store write."/>
          <TextBlock Text="Opening saved or supplied JSON makes no service request. Source claims stay historical/unverified; the complete original bytes are retained for JSON export." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Usage results">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
          <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
          <WrapPanel>
            <StackPanel Margin="0,0,12,4"><TextBlock Text="Source or provenance"/><ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Width="300" AutomationProperties.Name="Usage evidence table"/></StackPanel>
            <StackPanel Margin="0,0,0,4"><TextBlock Text="Search displayed values"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" AutomationProperties.Name="Usage display search"/></StackPanel>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" Height="260" MinHeight="160" EnableRowVirtualization="True" EnableColumnVirtualization="True" ColumnWidth="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CellStyle="{StaticResource ReportCell}" ColumnHeaderStyle="{StaticResource ReportColumnHeader}" AutomationProperties.Name="Usage observations and source provenance"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Usage HTML" Command="{Binding HtmlCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read usage evidence for the current client first; wait for the current operation."/>
            <Button Content="Original usage JSON" Command="{Binding JsonCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Export complete original usage JSON for the current result. No identity join or managed-store admission."/>
            <Button Content="Usage CSV ZIP" Command="{Binding CsvCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read current-client usage evidence and wait; exports every source table, regardless of display filters."/>
            <Button Content="Usage Excel" Command="{Binding ExcelCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read current-client usage evidence and wait; exports every source table, regardless of display filters."/>
          </WrapPanel>
          <TextBlock Text="Display filters never limit complete exports. Failed sources stay visible in provenance, not successful empty tables." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11"/>
          <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Usage export output path"/>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Original report">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
          <TextBlock Text="Keep the original evidence" Style="{StaticResource H2}"/>
          <TextBox Text="{Binding PendingSummary, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Height="130" MinHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Original usage report client and recovery status"/>
          <WrapPanel>
            <Button Content="Save original to managed evidence" Command="{Binding SaveOriginalCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Requires a pending original, idle workspace and at most32MiB. Larger valid packs (up to40MiB) must be separately exported. Never overwrites or reruns."/>
            <Button Content="Export original usage JSON" Command="{Binding ExportOriginalCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Available when an original usage report is pending and no operation is active. Keeps its original client and verifies written bytes; never reruns collection."/>
            <Button Content="Discard original usage report" Command="{Binding DiscardOriginalCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available for a pending original when idle. Requires explicit confirmation; discards no managed record and performs no service request."/>
          </WrapPanel>
          <TextBlock Text="HTML/CSV/Excel do not replace the complete original JSON/CSV evidence pack. Managed saves up to32MiB are included in workspace backup. Valid packs over32MiB and up to40MiB must be separately exported; those exports are not in managed backup. Resolve pending evidence before another usage read or ordinary close." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
