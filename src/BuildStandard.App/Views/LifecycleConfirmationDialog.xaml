<Window x:Class="BuildStandard.App.Views.LifecycleConfirmationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review one lifecycle action" Width="820" Height="620" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BgWindow}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="ONE EXACT TENANT WRITE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Review this action" Style="{StaticResource H1}"/><TextBlock Text="Approve only the original target and values below. This does not complete the whole workflow." TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap"/><TextBox Text="{Binding PreviewIdentity, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.Name="Exact lifecycle confirmation identity and expiry"/><TextBox Text="{Binding ExactRequest, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Exact lifecycle confirmation request"/></StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <CheckBox x:Name="ProtectedReview" IsChecked="{Binding ProtectedReviewed}" AutomationProperties.Name="Confirm protected-account review"><TextBlock Text="I reviewed the organisation's protected/emergency-account list. This exact target is authorised and not protected." TextWrapping="Wrap"/></CheckBox>
   <CheckBox IsChecked="{Binding DownstreamReviewed}" AutomationProperties.Name="Confirm downstream ownership review"><TextBlock Text="I reviewed downstream ownership and workload/external privileges. Unknown authority remains manual; this is not a general non-privilege guarantee." TextWrapping="Wrap"/></CheckBox>
   <CheckBox IsChecked="{Binding PreservationReviewed}" Visibility="{Binding PreservationRequired, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Confirm preservation retention and business-owner review"><TextBlock Text="I completed the required preservation/retention and business-owner review for this exact service withdrawal. The tool has not verified holds, data preservation or Exchange dependencies." TextWrapping="Wrap"/></CheckBox>
   <TextBlock Text="{Binding ApplyGuidance}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" Click="Cancel" IsDefault="True" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Approve this one action" Click="Approve" IsEnabled="{Binding CanApply}" IsDefault="False" AutomationProperties.Name="Approve the exact lifecycle action"/></StackPanel>
 </Grid>
</Window>
