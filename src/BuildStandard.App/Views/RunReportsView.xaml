<UserControl x:Class="BuildStandard.App.Views.RunReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BuildStandard.App.Infrastructure">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="28,14,28,8">
        <TextBlock Text="EXPERIMENTAL · REGISTERED READ-ONLY RUNNER" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Run reports" Style="{StaticResource H1}"/>
        <TextBlock Text="Review and approve one bounded read. Exchange uses separate Microsoft authentication. Live tenant behaviour is unverified." Style="{StaticResource Lead}"/>
      </StackPanel>
      <Grid Grid.Row="1" Margin="28,0,28,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="REGISTERED REPORTS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Runnable registered reports">
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="Read only · live unverified" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10" Margin="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <CheckBox Content="I approve the exact read-only review shown here" IsChecked="{Binding Approved}" IsEnabled="{Binding HasReview}" AutomationProperties.Name="Approve this exact read-only run"/>
              <WrapPanel Margin="0,6,0,0">
                <Button Content="Review run" Command="{Binding ReviewCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Review exact read-only run"/>
                <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Run reviewed read-only report"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Cancel this read-only run"/>
              </WrapPanel>
              <TextBlock Text="{Binding Availability}" Style="{StaticResource Muted}"/>
              <TextBlock Text="{Binding Message}" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8" Visibility="{Binding HasPendingEvidence, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="ORIGINAL REPORT NEEDS SAVING" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="This report belongs to the original client. Resolve it before running another report or closing the app."/>
                <Expander Header="Original client and report identity"><TextBox Text="{Binding PendingSummary, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" MaxHeight="130" AutomationProperties.Name="Original unsaved report identity"/></Expander>
                <WrapPanel>
                  <Button Content="Save to original client" Command="{Binding SaveEvidenceCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Save original unsaved report"/>
                  <Button Content="Export original JSON" Command="{Binding ExportEvidenceCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Export original unsaved report" ToolTip="Choose a new file. Existing files cannot be overwritten."/>
                  <Button Content="Discard original report…" Command="{Binding DiscardEvidenceCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Discard original unsaved report"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TabControl SelectedIndex="{Binding SelectedTab}">
              <TabItem Header="Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="8">
                    <CheckBox Content="Enable experimental read-only runs for this connection" IsChecked="{Binding ExperimentalReadEnabled}" IsEnabled="{Binding CanOptIn}" AutomationProperties.Name="Enable experimental read-only runs"/>
                    <TextBlock Text="Off by default; reconnecting or changing context removes it. This is separate from the tenant-write opt-in and grants no consent." Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                    <Expander Header="Verified connection and prerequisites" Margin="0,0,0,8">
                      <StackPanel Margin="0,6,0,0"><TextBlock Text="{Binding ContextText}"/><TextBlock Text="{Binding Requirements}" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="Use approved installed runtimes/modules. If policy or application control blocks the runner, ask your security owner; no install, bypass, alternative host or retry is offered." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
                    </Expander>
                    <TextBlock Text="PowerShell runtime" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Runtimes}" SelectedItem="{Binding Runtime}" AutomationProperties.Name="Reviewed PowerShell runtime" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Fields}" AutomationProperties.Name="Read-only report typed form" IsTabStop="False" ItemTemplate="{StaticResource ScriptParameterFieldTemplate}"/>
                    <ItemsControl ItemsSource="{Binding Problems}" IsTabStop="False" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Danger}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Exact review">
                <TextBox Text="{Binding ReviewText, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontSize="12" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact read-only run review" Margin="8"/>
              </TabItem>
              <TabItem Header="Outcome">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel Margin="8" MinHeight="360" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <WrapPanel><ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" Width="90" Margin="0,0,8,0" AutomationProperties.Name="Read-only report export format"/><Button Content="Export report" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Save or export original evidence first, then export the complete report for the current client without another read."/><!-- Existing deliberate copy actions. --><Button Content="Copy outcome" Command="{Binding CopyOutcomeCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Copy evidence JSON" Command="{Binding CopyEvidenceCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Open mailbox capacity" Command="{Binding OpenMailboxCapacityCommand}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Open mailbox capacity evidence review" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MailboxReviewGuidance}"/></WrapPanel>
                    <TextBox Text="{Binding LastExport, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" MaxHeight="48" AutomationProperties.Name="Last successful original report export" Visibility="{Binding HasReportExport, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding LocalOutputGuidance}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding MailboxReviewGuidance}" Style="{StaticResource Muted}"/>
                  </StackPanel>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBox Text="{Binding Output, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontSize="12" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Read-only run outcome"/>
                    <StackPanel Grid.Row="1" Margin="0,6,0,6">
                      <TextBlock Text="Report section" Style="{StaticResource FieldLabel}"/>
                      <ComboBox ItemsSource="{Binding OutcomeSections}" SelectedItem="{Binding SelectedOutcomeSection}" DisplayMemberPath="Display" AutomationProperties.Name="Read-only report section" MinWidth="180" HorizontalAlignment="Stretch"/>
                      <CheckBox Content="Show review cues and unknowns only (display filter)" IsChecked="{Binding OnlyNeedsReview}" Visibility="{Binding CanFilterRuleCues, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Show inbox rule review cues and unknowns" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding OutcomeSectionGuidance}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding OutcomeRows}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinHeight="120" ColumnWidth="180" EnableRowVirtualization="True" EnableColumnVirtualization="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Read-only Exchange report rows" CellStyle="{StaticResource ReportCell}" ColumnHeaderStyle="{StaticResource ReportColumnHeader}"/>
                  </Grid>
                </DockPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
