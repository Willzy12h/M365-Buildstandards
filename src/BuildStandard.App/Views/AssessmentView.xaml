<UserControl x:Class="BuildStandard.App.Views.AssessmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BuildStandard.App.Infrastructure">
  <!-- The page fills the window down to a minimum height, then scrolls: a short window (a laptop at 150% scaling)
       would otherwise squeeze the tables and guidance below it out of reach. See PageLayout.MinimumHeight. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="BUILD 2 / COMPARE WITH THE STANDARD" Style="{StaticResource Eyebrow}"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Re-run assessment" Command="{Binding ReassessCommand}" VerticalAlignment="Top" Margin="20,0,0,0"/><TextBlock Text="Assessment" Style="{StaticResource H1}"/></DockPanel>
          <TextBlock Text="Review property-level matches, gaps and unknown results. Select a finding to inspect the supporting evidence." Style="{StaticResource Lead}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130"><StackPanel>
            <TextBlock Text="{Binding SummaryText}" FontSize="12" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Summary.Groups}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource BgPanel}" Padding="8,5" Margin="0,0,8,6" ToolTip="{Binding Meaning}"><TextBlock><Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Count, Mode=OneWay}"/></TextBlock></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding HiddenSelectionText}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding HiddenSelectionText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel></ScrollViewer>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" MaxHeight="130"><StackPanel>
            <Expander Header="Needs review · partial, missing, manual and licence breakdown" Padding="0,1" Margin="0,4,0,4"><ItemsControl ItemsSource="{Binding Summary.ReviewBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock ToolTip="{Binding Meaning}"><Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Count, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            <Expander Header="Collection gaps and limitations" Padding="0,1" Margin="0,6,0,0"><ItemsControl ItemsSource="{Binding Limitations}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            <Expander Header="Export assessment reports" Padding="0,1" Margin="0,6,0,0">
              <StackPanel Margin="0,8,0,0">
                <WrapPanel>
                  <Button Content="Engineer report (HTML)" Command="{Binding ExportHtmlCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Client summary (HTML)" Command="{Binding ExportClientCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Excel" Command="{Binding ExportXlsxCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="CSV (zip)" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}"/>
                  <Button Content="Open export folder" Command="{Binding OpenExportCommand}" Style="{StaticResource QuietButton}"/>
                </WrapPanel>
                <TextBox AutomationProperties.Name="Last exported report" Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MinHeight="0" Padding="0" Margin="0"/>
              </StackPanel>
            </Expander>
            <Expander Header="Compare with another release (upgrade impact)" Padding="0,1" Margin="0,6,0,0" AutomationProperties.Name="Compare with another release">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding CompareGuidance}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel>
                  <TextBlock Text="Compare from" VerticalAlignment="Center" Margin="0,0,8,12"/>
                  <ComboBox Width="150" ItemsSource="{Binding CompareReleases}" SelectedItem="{Binding CompareRelease, Mode=TwoWay}" AutomationProperties.Name="Release to compare from"/>
                  <Button Content="Export upgrade impact (HTML)" Command="{Binding ExportUpgradeImpactCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,12"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel></ScrollViewer>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
          <DockPanel>
            <Grid DockPanel.Dock="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="Area" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AreaFilters}" SelectedItem="{Binding FilterArea, Mode=TwoWay}" AutomationProperties.Name="Filter assessment area" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Result" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FilterStatus, Mode=TwoWay}" AutomationProperties.Name="Filter results" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Category" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding FilterCategory, Mode=TwoWay}" AutomationProperties.Name="Filter category" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="Search" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search findings"/></StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ViewStateText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" AutomationProperties.Name="Assessment evidence source and filter result"/>
            <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Assessment findings" RowHeight="56" MinRowHeight="56">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Control" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <StackPanel><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ControlId}" Style="{StaticResource Mono}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Result" Width="160" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusKey, Converter={StaticResource StatusToBrush}}" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0">
            <TabControl SelectedIndex="1">
              <TabItem Header="Check an area or requirement"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel>
                <TextBlock Text="Check only what you need" FontWeight="SemiBold"/>
                <TextBlock Text="Partial results are separate from the full assessment and cannot authorise deployment." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <CheckBox Content="Review stored evidence instead of reading live" IsChecked="{Binding CheckStored}" AutomationProperties.Name="Review stored evidence instead of reading live"/>
                <TextBlock Text="{Binding CheckGuidance}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                <TextBlock Text="Area" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding CheckAreas}" SelectedItem="{Binding CheckArea}" AutomationProperties.Name="Area to check"/>
                <Button Content="Check this area" Command="{Binding CheckAreaCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                <TextBlock Text="Requirement" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding CheckControls}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding CheckControl}" AutomationProperties.Name="Requirement to check"/>
                <Button Content="Check this requirement" Command="{Binding CheckControlCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding PartialCheckText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="220" AutomationProperties.Name="Partial check result and evidence"/>
                <Button Content="Copy partial result" Command="{Binding CopyPartialCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
              </StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Finding evidence"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel>
                <TextBox AutomationProperties.Name="Selected finding detail" Text="{Binding SelectedDetail, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Margin="0,0,0,4"/>
                <Button Content="Add to plan" Command="{Binding AddToPlanCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding AddToPlanGuidance}" AutomationProperties.Name="Add selected finding to plan"/>
                <TextBlock Text="{Binding AddToPlanGuidance}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Button Content="Copy finding detail" Command="{Binding CopyDetailCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></ScrollViewer></TabItem>
              <TabItem Header="Compare settings"><DockPanel Margin="0,12,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Matching or overlapping object" Style="{StaticResource FieldLabel}"/>
              <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Matching object"/>
              <TextBlock DockPanel.Dock="Top" Text="{Binding CandidateText}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
              <Expander DockPanel.Dock="Bottom" Header="Proposed candidate JSON" Margin="0,8,0,0"><TextBox AutomationProperties.Name="Proposed payload" Text="{Binding ProposedJson, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" FontFamily="Consolas" FontSize="11" Height="150" Margin="0,8,0,0"/></Expander>
              <DataGrid ItemsSource="{Binding Differences}" AutomationProperties.Name="Property comparison">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="*"/>
                  <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*"/>
                  <DataGridTextColumn Header="Standard" Binding="{Binding Standard}" Width="*"/>
                  <DataGridCheckBoxColumn Header="Match" Binding="{Binding Match}" Width="65"/>
                </DataGrid.Columns>
              </DataGrid>
              </DockPanel></TabItem>
            </TabControl>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
