<UserControl x:Class="BuildStandard.App.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,20">
   <TextBlock Text="ENGINEER COMMAND CENTRE" Style="{StaticResource Eyebrow}"/>
   <TextBlock Text="What needs your attention?" Style="{StaticResource H1}"/>
   <TextBlock Text="{Binding Projection.Headline}" Style="{StaticResource Lead}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home headline"/>
   <TextBlock Text="{Binding Projection.ContextSummary}" Style="{StaticResource Muted}" Margin="0,0,0,16" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home context summary"/>
   <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14"><DockPanel>
    <Button x:Name="HomeNextStepButton" DockPanel.Dock="Right" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="250" AutomationProperties.Name="{Binding Projection.NextActionLabel}" AutomationProperties.HelpText="{Binding Projection.Guidance}" ToolTip="{Binding Projection.DisabledReason}"><TextBlock Text="{Binding Projection.NextActionLabel}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    <StackPanel><TextBlock Text="NEXT RECOMMENDED STEP" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Projection.Guidance}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home next step guidance"/></StackPanel>
   </DockPanel></Border>
   <ItemsControl ItemsSource="{Binding PrimaryTasks}" AutomationProperties.Name="Command centre workflows">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,10,14"><StackPanel>
     <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="17"/>
     <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
     <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Description}"><TextBlock Text="{Binding ActionLabel}" TextWrapping="Wrap"/></Button>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,16,0"><StackPanel>
     <TextBlock Text="Recent evidence" Style="{StaticResource H2}"/>
     <TextBlock Text="Evidence currently open. History holds other saved records; capture times below remain original UTC values." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding RecentEvidence}" AutomationProperties.Name="Original evidence open in this workspace"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip="{Binding Provenance}"/>
       <TextBlock Text="{Binding CapturedAt}" Style="{StaticResource Muted}" FontSize="11"/>
       <TextBlock Text="{Binding Status}" FontSize="11"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="No saved evidence is open for this client. Choose a capture in History, or connect and collect fresh evidence." ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasRecentEvidence}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16"><StackPanel>
     <TextBlock Text="Attention" Style="{StaticResource H2}"/>
     <TextBlock Text="{Binding Projection.Guidance}" Margin="0,0,0,14"/>

     <TextBlock Text="{Binding BoundaryText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
    </StackPanel></Border>
   </Grid>
   <TextBlock Text="Repeat review and engineer handover" Style="{StaticResource H2}" Margin="0,20,0,8"/>
   <ItemsControl ItemsSource="{Binding Tasks}" AutomationProperties.Name="Existing engineer workflows"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Description}" Margin="0,0,8,8"><TextBlock Text="{Binding ActionLabel}" TextWrapping="Wrap"/></Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Expander Header="Client, connection and original evidence details" Margin="0,8" AutomationProperties.Name="Home context details"><StackPanel>
    <TextBlock Text="{Binding Projection.ClientText}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home client status"/>
    <TextBlock Text="{Binding Projection.ConnectionText}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home connection status"/>
    <TextBlock Text="{Binding Projection.EvidenceText}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home evidence status"/>
    <TextBlock Text="{Binding Projection.StandardText}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.HelpText="Home standard status"/>
   </StackPanel></Expander>
   <ItemsControl ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="Home page shortcuts"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Description}" Margin="0,0,8,8"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
 </ScrollViewer>
</UserControl>
