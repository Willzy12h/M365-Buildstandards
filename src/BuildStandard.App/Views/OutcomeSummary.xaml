<UserControl x:Class="BuildStandard.App.Views.OutcomeSummary"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Recorded outcome qualifications">
 <Border Style="{StaticResource Card}" Padding="12"><StackPanel>
  <TextBlock Text="Recorded outcomes · separate facts" Style="{StaticResource H2}" FontSize="17"/>
  <TextBlock Text="{Binding OutcomeSummaryText}" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  <TextBlock Text="{Binding OutcomeProtectionText}" Foreground="{StaticResource Warn}" Margin="0,8,0,0" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 </StackPanel></Border>
</UserControl>
