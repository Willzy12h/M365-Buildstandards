<UserControl x:Class="BuildStandard.App.Views.CandidateAuthoringPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,12,12,12" IsEnabled="{Binding Workspace.Idle}">
  <TextBlock Text="Local candidate — no tenant operations" Style="{StaticResource H2}"/>
  <TextBlock Text="Published catalogues remain unchanged. Imports are not yet available in this editor; use only the supported existing settings shown here." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
  <TextBlock Text="New draft title" Style="{StaticResource FieldLabel}"/>
  <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New local candidate title"/>
  <WrapPanel Margin="0,8,0,0">
   <Button Content="Create from loaded standard" Command="{Binding NewDraftCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Load a verified standard, then save or discard any existing draft."/>
   <Button Content="Open saved draft" Command="{Binding OpenDraftCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Save or discard current edits before opening another local draft."/>
  </WrapPanel>
  <TextBox Text="{Binding Identity, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" AutomationProperties.Name="Candidate baseline and draft identity"/>
  <TextBlock Text="Control" Style="{StaticResource FieldLabel}"/>
  <ComboBox ItemsSource="{Binding Controls}" SelectedItem="{Binding SelectedControl}" DisplayMemberPath="Name" AutomationProperties.Name="Candidate control"/>
  <Button Content="Show settings" Command="{Binding LoadFieldsCommand}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open a draft and select a control. Apply or reset pending input first."/>
  <TextBlock Text="Setting or shared default" Style="{StaticResource FieldLabel}"/>
  <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" DisplayMemberPath="Path" AutomationProperties.Name="Candidate setting path"/>
  <TextBlock Text="Published baseline value (JSON)" Style="{StaticResource FieldLabel}"/>
  <TextBox Text="{Binding OriginalValue, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Candidate original setting value"/>
  <TextBlock Text="Proposed value" Style="{StaticResource FieldLabel}"/>
  <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Candidate proposed setting value"/>
  <TextBlock Text="{Binding ValueHint}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
  <WrapPanel>
   <Button Content="Apply to draft" Command="{Binding ApplyCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Select a setting and enter a changed value. The shared engine refuses unsupported changes."/>
   <Button Content="Reset input" Command="{Binding ResetInputCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Enter a changed value first. Reset restores the currently proposed value."/>
   <Button Content="Validate candidate" Command="{Binding ValidateCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open a current draft and apply or reset pending input before validation."/>
  </WrapPanel>
  <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" AutomationProperties.Name="Candidate next step and unavailable action explanation" Margin="0,8"/>
  <WrapPanel>
   <Button Content="Save draft" Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open a draft and apply or reset pending input. Saving does not publish or deploy."/>
   <Button Content="Export candidate and comparison" Command="{Binding ExportCandidateCommand}" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Validate the exact current draft first. Pending input or changed context blocks export."/>
   <Button Content="Discard unsaved draft" Command="{Binding DiscardDraftCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open a draft first. This discards local unsaved edits only; existing files are kept."/>
  </WrapPanel>
  <TextBox Text="{Binding Message, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" AutomationProperties.Name="Candidate operation result"/>
 </StackPanel>
</UserControl>
