<UserControl x:Class="BuildStandard.App.Views.CatalogueReaderView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Left" Content="Back to control" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="Catalogue reference" Style="{StaticResource H1}" Margin="12,0"/></DockPanel>
  <Expander Grid.Row="1" Header="Document identity — separate from current client" Margin="0,6"><TextBox Text="{Binding DocumentIdentity, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" AutomationProperties.Name="Catalogue document identity"/></Expander>
  <StackPanel Grid.Row="2">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding OpenedAt}" Style="{StaticResource Muted}"/>
   <WrapPanel Margin="0,6">
    <Button Content="Retry reader" Command="{Binding RetryCommand}" Style="{StaticResource QuietButton}" AutomationProperties.HelpText="Available after a reader failure in the same current context. No sign-in, installation or policy bypass."/>
    <Button Content="Save HTML" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}"/>
    <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="Find text in catalogue" Margin="8,0" IsEnabled="{Binding IsReady}" ToolTip="Find is available after the current catalogue is displayed. Use Save HTML or Back if the reader is unavailable."/>
    <Button Content="Find" ToolTipService.ShowOnDisabled="True" ToolTip="Available after the current catalogue is displayed. Use Save HTML or Back if the reader is unavailable." AutomationProperties.HelpText="Available when the current catalogue is displayed." Command="{Binding FindCommand}" Style="{StaticResource QuietButton}"/>
    <Button Content="Zoom in" ToolTipService.ShowOnDisabled="True" ToolTip="Available after the current catalogue is displayed. Use Save HTML or Back if the reader is unavailable." AutomationProperties.HelpText="Available when the current catalogue is displayed." Command="{Binding ZoomInCommand}" Style="{StaticResource QuietButton}"/><Button Content="Zoom out" ToolTipService.ShowOnDisabled="True" ToolTip="Available after the current catalogue is displayed. Use Save HTML or Back if the reader is unavailable." AutomationProperties.HelpText="Available when the current catalogue is displayed." Command="{Binding ZoomOutCommand}" Style="{StaticResource QuietButton}"/>
   </WrapPanel>
   <TextBlock Text="Select a Microsoft reference in the document to review its destination here. It remains blocked in the reader until you choose Open Microsoft reference." FontSize="11" TextWrapping="Wrap"/>
   <StackPanel Visibility="{Binding HasPendingReference, Converter={StaticResource BoolToVis}}">
   <TextBox Text="{Binding PendingReference, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" AutomationProperties.Name="Selected Microsoft reference destination"/>
   <Button Content="Open Microsoft reference" Command="{Binding OpenReferenceCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
   </StackPanel>
   <TextBlock Text="{Binding Saved}" TextWrapping="Wrap"/>
  </StackPanel>
  <!-- Native controls never overlay the hosted browser rectangle. -->
  <Grid x:Name="BrowserSlot" Grid.Row="3" Margin="0,8,0,0"/>
 </Grid>
</UserControl>
