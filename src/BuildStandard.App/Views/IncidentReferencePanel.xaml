<UserControl x:Class="BuildStandard.App.Views.IncidentReferencePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
  <TextBlock Text="Incident control references" Style="{StaticResource H2}"/>
  <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" Margin="0,6,0,8"/>
  <TextBlock Text="One unambiguous incident in the current original"/><ComboBox ItemsSource="{Binding Incidents}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedIncidentId}" AutomationProperties.Name="Exact incident reference source"/>
  <TextBlock Text="Control in the verified loaded catalogue" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Controls}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedControlId}" AutomationProperties.Name="Exact incident reference target control"/>
  <WrapPanel Margin="0,10,0,8">
   <Button Content="Add incident reference" Command="{Binding AddCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open incident evidence for this client and choose an unambiguous incident and verified catalogue control."/>
   <Button Content="Save incident references" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available when source-bound references exist and no operation is active."/>
   <Button Content="Open references JSON" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open the exact original incident report first. Save or discard unsaved references before replacing them."/>
   <Button Content="Discard unsaved references…" Command="{Binding DiscardCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available for unsaved references; confirmation preserves incident originals and saved files."/>
  </WrapPanel>
  <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Incident reference source identity and pending state"/>
  <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="True" Height="160" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Exact incident control reference identities and resolution" Margin="0,8,0,8"/>
  <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Incident reference output path"/>
 </StackPanel></ScrollViewer>
</UserControl>
