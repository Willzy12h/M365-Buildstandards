<UserControl x:Class="BuildStandard.App.Views.ExternalCheckReviewPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="External results · untrusted source claims" Style="{StaticResource H2}"/>
   <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,6" AutomationProperties.Name="External claims admission status"/>
  </StackPanel>
  <TabControl Grid.Row="1">
   <TabItem Header="Source and original"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
    <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"/>
    <Button Content="Open neutral results JSON" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,8" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Guidance}"/>
    <TextBlock Text="{Binding PendingSummary}" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,8,0,8">
     <Button Content="Export pending original" Command="{Binding ExportOriginalCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available when an original is pending and no operation is active. Keeps its original source client."/>
     <Button Content="Discard pending data…" Command="{Binding DiscardCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available for a pending original or unsaved references; asks before discarding. Saved files are retained."/>
    </WrapPanel>
    <TextBox Text="{Binding Provenance, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" AutomationProperties.Name="External source tool version tenant timestamps counts and hashes"/>
    <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="External results output path"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Claimed results"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Search source IDs, titles, outcomes and reasons. Source outcome categories never become native compliance. Exports always include all rows." TextWrapping="Wrap"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Search external claimed results" Margin="0,6,0,6"/></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="110" AutomationProperties.Name="Untrusted external result rows">
     <DataGrid.Columns><DataGridTextColumn Header="Source ID" Binding="{Binding TestId}" Width="140"/><DataGridTextColumn Header="Claimed outcome" Binding="{Binding DisplayOutcome}" Width="120"/><DataGridTextColumn Header="Raw outcome" Binding="{Binding Outcome}" Width="120"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="280"/><DataGridTextColumn Header="Reference text (not opened)" Binding="{Binding Reference}" Width="240"/></DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="HTML" Command="{Binding HtmlCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Original JSON" Command="{Binding JsonCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="CSV" Command="{Binding CsvCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Excel" Command="{Binding ExcelCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="Open current-client results and wait for the local operation to enable exports." TextWrapping="Wrap" MaxWidth="330"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="Control references"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
    <TextBlock Text="Link a source test to an exact control in the verified loaded catalogue. This is engineer-entered context only; no verdict, ownership, job or deployment approval is changed." TextWrapping="Wrap"/>
    <TextBlock Text="Source test ID" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding SourceTests}" SelectedItem="{Binding SelectedTestId}" AutomationProperties.Name="Exact external source test ID"/>
    <TextBlock Text="Control in the loaded standard" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding Controls}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedControlId}" AutomationProperties.Name="Exact external reference target control"/>
    <WrapPanel Margin="0,10,0,8"><Button Content="Add reference" Command="{Binding AddReferenceCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open results for this client, load a verified catalogue and choose an exact source test and control."/><Button Content="Save references" Command="{Binding SaveReferencesCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available when references exist and no local operation is active. Preserves the original source."/><Button Content="Open references JSON" Command="{Binding OpenReferencesCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open current-client results first; save or discard unsaved references before replacing them."/></WrapPanel>
    <DataGrid ItemsSource="{Binding ReferenceRows}" IsReadOnly="True" AutoGenerateColumns="True" Height="160" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Exact external control reference identities and resolution"/>
    <TextBox Text="{Binding ReferenceSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="External reference resolution summary"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
