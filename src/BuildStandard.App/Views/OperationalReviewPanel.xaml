<UserControl x:Class="BuildStandard.App.Views.OperationalReviewPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <TabControl Margin="4">
  <TabItem Header="Read context"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
   <TextBlock Text="Operational context · experimental and read-only" Style="{StaticResource H2}"/>
   <TextBlock Text="Report"/>
   <ComboBox ItemsSource="{Binding ReportChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedReportId}" IsEnabled="{Binding CanEdit}" Width="280" HorizontalAlignment="Left" AutomationProperties.Name="Operational report selection"/>
   <StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPartnerReport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="Selected customer tenant ID (distinct from the connected partner)" TextWrapping="Wrap"/>
    <TextBox Text="{Binding CustomerTenantId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="36" MaxWidth="420" HorizontalAlignment="Stretch" AutomationProperties.Name="Partner report customer tenant ID"/>
    <CheckBox IsChecked="{Binding PartnerDeclared}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,0" AutomationProperties.Name="Declare connected partner source"><TextBlock Text="I declare the current verified connection as the partner source. This does not prove customer rights." TextWrapping="Wrap"/></CheckBox>
   </StackPanel>
   <StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCollaborationReport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="Site search (optional, up to 256 characters; * is a bounded visible-site search, not a full estate)" TextWrapping="Wrap"/>
    <TextBox Text="{Binding CollaborationSearch, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Bounded collaboration site search"/>
    <TextBlock Text="Exact selected site IDs, one per line. Keep SharePoint commas intact. Copy IDs from a saved search result; never enter a URL." TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBox Text="{Binding CollaborationSites, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact selected collaboration site IDs"/>
    <CheckBox IsChecked="{Binding IncludeLibraries}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,0" AutomationProperties.Name="Include existing selected-site libraries"><TextBlock Text="Read existing libraries for the selected sites. This does not discover or provision user OneDrive storage." TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="Find an existing group by name or exact ID" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <TextBlock Text="Uses existing Group.Read.All to look up at most 1,000 matching names and IDs. Enter the search, acknowledge the exact read below, then choose Search groups. A result does not establish Team provisioning." TextWrapping="Wrap"/>
    <TextBox Text="{Binding GroupQuery, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="200" AutomationProperties.Name="Collaboration group name or ID lookup"/>
    <ComboBox ItemsSource="{Binding GroupMatches}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Exact collaboration group lookup matches" Margin="0,4,0,4"/>
    <Button Content="Add selected group" Command="{Binding UseGroupCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding GroupSelectionGuidance}"/>
    <TextBlock Text="{Binding GroupLookupStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding GroupSelectionGuidance}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
    <TextBlock Text="Exact selected group or Team GUIDs, one per line. At most 50 sites and groups combined." TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBox Text="{Binding CollaborationGroups, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact selected collaboration group IDs"/>
    <CheckBox IsChecked="{Binding IncludeOwners}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,0" AutomationProperties.Name="Include direct group owners"><TextBlock Text="Read supported direct group owners. Service-principal owners are omitted by Graph v1.0; unknown or unsupported populations never become complete." TextWrapping="Wrap"/></CheckBox>
    <CheckBox IsChecked="{Binding IncludeMembers}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,0" AutomationProperties.Name="Include direct Team members"><TextBlock Text="Read direct Team members only where the returned group metadata establishes Team provisioning. Missing roles stay unknown." TextWrapping="Wrap"/></CheckBox>
   </StackPanel>
   <TextBlock Text="{Binding AccessPreview}" TextWrapping="Wrap" Margin="0,6,0,8"/>
   <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
   <Button Content="Connection and read access" Command="{Binding OpenConnectionCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="Open Connect when idle. Navigation does not authenticate or consent."/>
   <CheckBox IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanEdit}" Margin="0,8,0,8" AutomationProperties.Name="Acknowledge exact experimental operational read"><TextBlock Text="{Binding AcknowledgementText}" TextWrapping="Wrap"/></CheckBox>
   <WrapPanel><Button Content="Search groups" Command="{Binding SearchGroupsCommand}" Visibility="{Binding IsCollaborationReport, Converter={StaticResource BoolToVis}}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding GroupSearchGuidance}"/><Button Content="{Binding ReadLabel}" Command="{Binding ReadCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ReadGuidance}"/><Button Content="Stop context read" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available while this page owns an active capture. Earlier admitted observations remain; original retention continues before close."/></WrapPanel>
   <TextBlock Text="{Binding GroupSearchGuidance}" Visibility="{Binding IsCollaborationReport, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock Text="{Binding ReadGuidance}" TextWrapping="Wrap" Margin="0,6,0,8"/>
   <Button Content="Open saved or supplied operational JSON" Command="{Binding OpenCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="Select the original source client, wait for the operation and resolve pending originals. Opens strict16MiB operational evidence only; no service request."/>
   <TextBlock Text="Opening JSON keeps source claims historical/unverified and does not insert a managed record. An empty table establishes absence only where its source read completed." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Context results"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
   <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
   <WrapPanel>
    <StackPanel Margin="0,0,12,4"><TextBlock Text="Source or provenance"/><ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Width="300" AutomationProperties.Name="Operational evidence table"/></StackPanel>
    <StackPanel Margin="0,0,0,4"><TextBlock Text="Search displayed values"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" AutomationProperties.Name="Operational display search"/></StackPanel>
   </WrapPanel>
   <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" Height="260" MinHeight="160" EnableRowVirtualization="True" EnableColumnVirtualization="True" ColumnWidth="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CellStyle="{StaticResource ReportCell}" ColumnHeaderStyle="{StaticResource ReportColumnHeader}" AutomationProperties.Name="Operational observations and source provenance"/>
   <WrapPanel Margin="0,8,0,0">
    <Button Content="Context HTML" Command="{Binding HtmlCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read evidence for this source client and wait for the operation. Exports every table, regardless of display filters."/>
    <Button Content="Original context JSON" Command="{Binding JsonCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read evidence for this source client and wait; exports exact original bytes, without source-authenticity assurance."/>
    <Button Content="Context CSV ZIP" Command="{Binding CsvCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read current-source evidence and wait; exports every table and original read state."/>
    <Button Content="Context Excel" Command="{Binding ExcelCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Open/read current-source evidence and wait; exports every table and original read state."/>
   </WrapPanel>
   <TextBlock Text="Display filters never limit complete exports. Advisories cannot prove tenant availability, effective rights or the cause of a failed collection." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}"/>
   <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Operational export output path"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Original context"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
   <TextBlock Text="Keep the original source evidence" Style="{StaticResource H2}"/>
   <TextBox Text="{Binding PendingSummary, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Height="130" MinHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Original operational report source and recovery status"/>
   <WrapPanel>
    <Button Content="Save original context to evidence" Command="{Binding SaveOriginalCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Requires an idle workspace and pending original. Preserves the exact source record in managed evidence and ordinary backup; no overwrite or rerun."/>
    <Button Content="Export original context JSON" Command="{Binding ExportOriginalCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Requires an idle workspace and pending original. Keeps its original source client and verifies output bytes; no new read."/>
    <Button Content="Discard original context" Command="{Binding DiscardOriginalCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Requires a pending original, idle workspace and explicit confirmation. Deletes no managed record and runs no command."/>
   </WrapPanel>
   <TextBlock Text="HTML/CSV/Excel do not replace original evidence. Managed operational originals fit within the unchanged backup bound. Resolve pending originals before replacement or ordinary close; changing client never relabels them." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
  </StackPanel></ScrollViewer></TabItem>
 </TabControl>
</UserControl>
