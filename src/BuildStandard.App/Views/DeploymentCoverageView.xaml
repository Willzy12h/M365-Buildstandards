<UserControl x:Class="BuildStandard.App.Views.DeploymentCoverageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,12">
   <TextBlock Text="REPORTS / SELECTED CONTROL" Style="{StaticResource Eyebrow}"/>
   <TextBlock Text="Deployment coverage" Style="{StaticResource H1}"/>
   <TextBox Text="{Binding ContextSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Coverage client and connection context"/>
   <TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" Margin="0,8"/>
   <Border Style="{StaticResource Card}" Padding="12" Margin="0,8">
    <StackPanel>
     <TextBlock Text="1 · Choose the source scope" Style="{StaticResource H2}"/>
     <TextBlock Text="Use an original configuration capture and a known toolkit-created object. Local mapping plus intact creation/readback evidence is checked before any request. Unmanaged legacy objects stay in configuration/naming review; this report does not adopt them." TextWrapping="Wrap" Margin="0,4,0,8"/>
     <TextBlock Text="Standard control"/><ComboBox ItemsSource="{Binding Controls}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ControlId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Coverage standard control" Margin="0,4,0,8"/>
     <TextBlock Text="Optional pilot: separate exact directory namespaces; comma, space or newline separated. Leave blank to review configured sources without a selected pilot." TextWrapping="Wrap"/>
     <WrapPanel IsEnabled="{Binding CanEdit}">
      <StackPanel Margin="0,4,12,8"><TextBlock Text="Entra user object IDs"/><TextBox Text="{Binding PilotUsers, UpdateSourceTrigger=PropertyChanged}" Width="280" MaxLength="200000" AutomationProperties.Name="Coverage pilot directory user object IDs"/></StackPanel>
      <StackPanel Margin="0,4,0,8"><TextBlock Text="Entra directory device object IDs"/><TextBox Text="{Binding PilotDevices, UpdateSourceTrigger=PropertyChanged}" Width="280" MaxLength="200000" AutomationProperties.Name="Coverage pilot directory device object IDs"/></StackPanel>
     </WrapPanel>
     <TextBlock Text="Do not use Intune managed-device IDs, device names or UPNs. A GUID shape alone does not establish which namespace it belongs to." TextWrapping="Wrap" Margin="0,0,0,8"/>
     <CheckBox IsChecked="{Binding ModernAcknowledged}" IsEnabled="{Binding CanUseModern}" ToolTip="{Binding ModernGuidance}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Acknowledge broader deployment token for fixed modern Intune reporting">
      <TextBlock Text="Include modern Intune service results. I understand this uses existing write-capable access for reporting, including one fixed export job; no configuration is changed." TextWrapping="Wrap"/>
     </CheckBox>
     <TextBlock Text="{Binding ModernGuidance}" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <CheckBox IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Acknowledge experimental coverage read"><TextBlock Text="I reviewed this selected-control source read and its limitations. It does not verify effective protection or approve any change." TextWrapping="Wrap"/></CheckBox>
     <WrapPanel Margin="0,10,0,0"><Button Content="Read coverage" Command="{Binding ReadCommand}" Style="{StaticResource PrimaryButton}" ToolTip="{Binding ReadGuidance}" ToolTipService.ShowOnDisabled="True"/><Button Content="Stop coverage" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Available during an active coverage read. Stop retains available originals and never replays a job." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
     <TextBlock Text="{Binding ReadGuidance}" TextWrapping="Wrap" Margin="0,4"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}" Padding="12" Margin="0,8">
    <StackPanel>
     <TextBlock Text="2 · Review original observations" Style="{StaticResource H2}"/>
     <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,6"/>
     <TextBox Text="{Binding OriginalReportDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="145" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Original coverage identity scope access and limitations"/>
     <TextBlock Text="Start with Source read states. A blank table alone is not a successful check; source state, namespace, time and limits determine what was checked." TextWrapping="Wrap" Margin="0,8,0,4"/>
     <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" AutomationProperties.Name="Coverage observation table"/>
     <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" RowHeight="32" Height="240" Margin="0,8" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Original coverage source observations"/>
     <WrapPanel><Button Content="HTML" Command="{Binding ExportHtmlCommand}" Style="{StaticResource SecondaryButton}" ToolTip="{Binding ExportGuidance}" ToolTipService.ShowOnDisabled="True"/><Button Content="Original JSON ZIP" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}" ToolTip="{Binding ExportGuidance}" ToolTipService.ShowOnDisabled="True"/><Button Content="CSV ZIP" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" ToolTip="{Binding ExportGuidance}" ToolTipService.ShowOnDisabled="True"/><Button Content="Excel XLSX" Command="{Binding ExportXlsxCommand}" Style="{StaticResource SecondaryButton}" ToolTip="{Binding ExportGuidance}" ToolTipService.ShowOnDisabled="True"/></WrapPanel>
     <TextBlock Text="{Binding ExportGuidance}" TextWrapping="Wrap"/>
     <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Coverage export path"/>
     <TextBlock Text="Open an original coverage JSON ZIP offline for the selected client. It stays historical/unverified, even if its recorded tenant and standard match." TextWrapping="Wrap" Margin="0,12,0,4"/>
     <TextBox Text="{Binding SourceFile, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Original coverage JSON ZIP input path"/>
     <WrapPanel Margin="0,6,0,0"><Button Content="Choose original ZIP" Command="{Binding ChooseCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Select a client, wait until idle and resolve retained originals before choosing another report." ToolTipService.ShowOnDisabled="True"/><Button Content="Open historical evidence" Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Choose the original coverage JSON ZIP for the selected client. Raw recovery folders are manual material, not an import format." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Card}" Padding="12" Margin="0,8">
    <StackPanel>
     <TextBlock Text="3 · Recover a retained original" Style="{StaticResource H2}"/>
     <TextBox Text="{Binding PendingSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Retained original coverage identity"/>
     <CheckBox IsChecked="{Binding RecoveryAcknowledged}" IsEnabled="{Binding HasPending}" Margin="0,8" AutomationProperties.Name="Acknowledge exact original coverage recovery"><TextBlock Text="I reviewed this exact original identity. It may belong to a previously selected client." TextWrapping="Wrap"/></CheckBox>
     <WrapPanel><Button Content="Save original evidence" Command="{Binding SaveOriginalCommand}" Style="{StaticResource SecondaryButton}" ToolTip="A conforming report must exist; wait until idle and acknowledge the original. Over-cap material uses original files instead; no cap is raised." ToolTipService.ShowOnDisabled="True"/><Button Content="Export original JSON ZIP" Command="{Binding ExportOriginalCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Requires a conforming retained report and exact-original acknowledgement. This never re-queries or overwrites evidence." ToolTipService.ShowOnDisabled="True"/><Button Content="Export original files" Command="{Binding ExportFilesCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Acknowledge the retained raw capture. Creates verified manual source copies, not complete report evidence or an import format; retain separately from workspace backup." ToolTipService.ShowOnDisabled="True"/><Button Content="Discard original…" Command="{Binding DiscardOriginalCommand}" Style="{StaticResource QuietButton}" ToolTip="Acknowledge and confirm only this retained original. Existing disk records are unchanged." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
