<UserControl x:Class="BuildStandard.App.Views.GraphReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:BuildStandard.App.Infrastructure">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{x:Static infra:PageLayout.MinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid Margin="28,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="REPORTS / READ-ONLY" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Tenant reports" Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding ContextSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"/>
      </StackPanel>
      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="0,8,0,0">
        <TabItem Header="Read a report"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,8">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="Report"/><ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Name" Width="300" AutomationProperties.Name="Registered report"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="Start UTC (logs only)"/><TextBox Text="{Binding StartUtc, UpdateSourceTrigger=PropertyChanged}" Width="200" IsEnabled="{Binding RequiresDates}" AutomationProperties.Name="Requested UTC start" ToolTip="UTC ISO timestamp, for example 2026-09-01T00:00:00Z. Clear dates for non-log reports."/></StackPanel>
            <StackPanel Margin="0,0,0,6"><TextBlock Text="End UTC (logs only)"/><TextBox Text="{Binding EndUtc, UpdateSourceTrigger=PropertyChanged}" Width="200" IsEnabled="{Binding RequiresDates}" AutomationProperties.Name="Requested UTC end" ToolTip="UTC ISO timestamp, after start, no later than now; maximum 31 days."/></StackPanel>
            <StackPanel Margin="12,0,0,6"><TextBlock Text="Expiry horizon (days)"/><TextBox Text="{Binding HorizonDays, UpdateSourceTrigger=PropertyChanged}" Width="110" IsEnabled="{Binding RequiresHorizon}" AutomationProperties.Name="Application expiry horizon days" ToolTip="Whole number from 1 to 365; default 30. Applies only to application credential expiry."/></StackPanel>
          </WrapPanel>
          <TextBlock Text="Dates apply only to logs (up to 31 days; no future end). Expiry uses a 1–365 day horizon from the fixed collection end. Consent uses neither dates nor horizon." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
          <Expander Header="Required permissions, limits and current access">
            <StackPanel><TextBlock Text="{Binding ScopeExplanation}" TextWrapping="Wrap" Margin="0,8,0,6"/><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap"/></StackPanel>
          </Expander>
          <CheckBox AutomationProperties.Name="Acknowledge experimental report read and limitations, without granting consent" IsChecked="{Binding ReadAcknowledged}" Margin="0,10,0,6"><TextBlock Text="I acknowledge this experimental read and its stated limits. This grants no consent or tenant-change approval." TextWrapping="Wrap"/></CheckBox>
          <WrapPanel><Button Content="Read selected report" Command="{Binding ReadCommand}"/><Button Content="Stop read" Command="{Binding StopReadCommand}" Style="{StaticResource SecondaryButton}" ToolTipService.ShowOnDisabled="True" ToolTip="Available only while this page owns an active report read. It does not stop another operation."/></WrapPanel>
          <TextBlock Text="Stop read is available only during this page's active report read." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11"/>
          <TextBlock Text="{Binding ReadGuidance}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
        </ScrollViewer></TabItem>
        <TabItem Header="Results">
          <Grid Margin="12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0">
        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"/>
        <WrapPanel Margin="0,4,0,4">
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Table / section"/><ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Width="180" Margin="0" AutomationProperties.Name="Report section"/></StackPanel>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Search visible values"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="270" Margin="0" AutomationProperties.Name="Report display search"/></StackPanel>
          <StackPanel><TextBlock Text="Row read state"/><ComboBox ItemsSource="{Binding RowStates}" SelectedItem="{Binding RowState}" IsEnabled="{Binding CanFilterReadState}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ReadStateFilterGuidance}" AutomationProperties.HelpText="{Binding ReadStateFilterGuidance}" Width="150" Margin="0" AutomationProperties.Name="Row read state display filter"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding SectionSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
      </StackPanel>
      <TabControl Grid.Row="1" Margin="0,4,0,0">
        <TabItem Header="Rows">
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinHeight="150" EnableRowVirtualization="True" EnableColumnVirtualization="True" ColumnWidth="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Typed report rows" CellStyle="{StaticResource ReportCell}" ColumnHeaderStyle="{StaticResource ReportColumnHeader}">

          </DataGrid>
        </TabItem>
        <TabItem Header="Selected row details"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8"><Button Content="Copy row details" Command="{Binding CopyRowCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Open evidence and select a row before copying its details. Wait for the current operation to finish." Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><TextBox Text="{Binding SelectedRowDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Height="200" MinHeight="100" Margin="0,4,0,8" Padding="8" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected report row identity and read details"/></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Provenance and limits"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8"><Button Content="Copy provenance" Command="{Binding CopyDetailsCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Open or read evidence before copying its original provenance. Wait for the current operation to finish." Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ProvenanceNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox Text="{Binding Details, Mode=OneWay}" Style="{StaticResource ReadOnlyDetail}" Height="200" MinHeight="100" Margin="0,4,0,8" Padding="8" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Report provenance and source claims"/></StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <StackPanel Grid.Row="2" Margin="0,4,0,0">
        <TextBlock Text="{Binding FilterSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11"/>
        <WrapPanel Margin="0,4,0,0"><Button Content="HTML report" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/><Button Content="JSON evidence" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/><Button Content="CSV ZIP" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/><Button Content="Excel XLSX" Command="{Binding ExportXlsxCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/><Button Content="Open export folder" Command="{Binding OpenExportCommand}" Margin="0" ToolTipService.ShowOnDisabled="True" ToolTip="Export this report first, then open the folder when the operation has finished." Style="{StaticResource QuietButton}"/></WrapPanel>
        <TextBlock Text="{Binding ExportGuidance}" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11"/>
        <TextBox Text="{Binding LastExport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="11" MaxHeight="48" VerticalScrollBarVisibility="Auto" Padding="0" MinHeight="0" Margin="0,4,0,0" AutomationProperties.Name="Complete report export output path">
          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding LastExport}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
      </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Saved evidence"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel Margin="0,8,0,0">
            <WrapPanel><Button Content="Refresh saved reports" Command="{Binding RefreshStoredCommand}" Style="{StaticResource SecondaryButton}"/><ComboBox ItemsSource="{Binding StoredReports}" SelectedItem="{Binding SelectedStored}" DisplayMemberPath="Label" Width="460" AutomationProperties.Name="Saved report record" Margin="0,0,8,0"/><Button Content="Open saved report" Command="{Binding OpenStoredCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
            <TextBlock Text="Refresh the offline list and select a readable record before opening saved evidence. Select a client and enter or choose a JSON path before opening supplied evidence." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,6,0,6"/>
            <TextBlock Text="{Binding StoredStatus}" TextWrapping="Wrap" Margin="0,4,0,4"/>
            <TextBlock Text="{Binding SelectedStored.Problem}" TextWrapping="Wrap"/>
            <WrapPanel><TextBox Text="{Binding SuppliedFile, UpdateSourceTrigger=PropertyChanged}" Width="460" AutomationProperties.Name="Supplied Graph report JSON path" Margin="0,0,8,0"/><Button Content="Choose JSON" Command="{Binding ChooseSuppliedCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="Open supplied JSON" Command="{Binding OpenSuppliedCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
            <TextBlock Text="Registered Graph schema 1 and application schema 2 evidence only, at most 32 MiB; the selected tenant is fixed. Invalid digest, wrong tenant, links, Exchange reports and configuration snapshots are refused." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </StackPanel>
        </ScrollViewer></TabItem>
      </TabControl>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
